<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>SefazSp.Epat.Api</RootNamespace>
    <!-- Elsa's Humanizer analyzer fails to load under net8 SDK; not a code issue. -->
    <NoWarn>$(NoWarn);CS8032</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Elsa" Version="3.7.1" />
    <PackageReference Include="Elsa.Scheduling" Version="3.7.1" />
    <!-- Track A: durable persistence — official Elsa EF Core provider (renamed line for 3.7.x). -->
    <PackageReference Include="Elsa.Persistence.EFCore.Sqlite" Version="3.7.1" />
    <!-- EF tools need Design in the startup project to generate/apply migrations. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.13" PrivateAssets="all" />
    <!-- Drop the broken Humanizer Roslyn analyzer; keep the library Elsa depends on. -->
    <PackageReference Include="Humanizer.Core" Version="3.0.1" ExcludeAssets="analyzers" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SefazSp.Epat.Application\SefazSp.Epat.Application.csproj" />
    <ProjectReference Include="..\SefazSp.Epat.Infrastructure\SefazSp.Epat.Infrastructure.csproj" />
    <ProjectReference Include="..\SefazSp.Epat.Domain\SefazSp.Epat.Domain.csproj" />
  </ItemGroup>

</Project>
