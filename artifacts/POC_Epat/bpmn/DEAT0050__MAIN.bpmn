    <bpmn:sequenceFlow id="F__lresFVqhEfG5K7mY0I3I6w" name="DATACONTROLE = «nao informado» ou DATACONTROLE &lt;&gt; PRAZODEFESA" sourceRef="_lrer_VqhEfG5K7mY0I3I6w" targetRef="_lrer2lqhEfG5K7mY0I3I6w">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">DATACONTROLE == IPESystemValues.SW_NA || DATACONTROLE != PRAZODEFESA;</bpmn:conditionExpression>
