  <bpmn:process id="P_DEAT0050_MAIN" name="Notificacao do AIIM" isExecutable="false">
    <bpmn:documentation>Processo TIBCO: Notificacao do AIIM  |  escopo: MAIN Gerado a partir de process-model.json. ARTEFATO DE ESPECIFICACAO - nao e executavel.</bpmn:documentation>
    <bpmn:endEvent id="_lrer2FqhEfG5K7mY0I3I6w" name="Fim">
      <bpmn:documentation>TIBCO id: _lrer2FqhEfG5K7mY0I3I6w | kind XPDL: endEvent | faixa: BPM</bpmn:documentation>
      <bpmn:incoming>F__lresLlqhEfG5K7mY0I3I6w</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="_lrer2lqhEfG5K7mY0I3I6w" name="Aguarda Defesa">
      <bpmn:documentation>TIBCO id: _lrer2lqhEfG5K7mY0I3I6w | kind XPDL: timerEvent | faixa: BPM | prazo: {&quot;grammar&quot;:&quot;JavaScript&quot;,&quot;expression&quot;:&quot;PRAZODEFESA;\nPRAZODEFESAT;&quot;,&quot;days&quot;:null,&quot;hours&quot;:null,&quot;minutes&quot;:null}</bpmn:documentation>
      <bpmn:incoming>F__lresFVqhEfG5K7mY0I3I6w</bpmn:incoming>
      <bpmn:outgoing>F__lresL1qhEfG5K7mY0I3I6w</bpmn:outgoing>
      <bpmn:timerEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:scriptTask id="_lrer3VqhEfG5K7mY0I3I6w" name="HoraFimSC">
      <bpmn:documentation>TIBCO id: _lrer3VqhEfG5K7mY0I3I6w | kind XPDL: scriptTask | faixa: BPM | script: @{grammar=JavaScript; body=DAYSOVER = 0;
PRAZODEFESAT = IPEDateTimeUtil.CALCTIME('23:59',0,0,DAYSOVER);

if (IPESystemValues.SW_HOSTNAME == 'des1')
{
	PRAZODEFESA = IPESystemValues.SW_DATE ;
	PRAZODEFESAT = IPEDateTimeUtil.CALCTIME(IPESystemValues.SW_TIME,1,0,DAYSOVER);
}}</bpmn:documentation>
      <bpmn:incoming>F__lresGlqhEfG5K7mY0I3I6w</bpmn:incoming>
      <bpmn:outgoing>F__lresLVqhEfG5K7mY0I3I6w</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:callActivity id="_lrer3lqhEfG5K7mY0I3I6w" name="CalculaPrazo" calledElement="P_CALCPRPC_MAIN">
