	if (STSADMTITCNT == IPESystemValues.SW_NA)
	{
		STSADMTITCNT = 0;
	}
	if (STSADMTITDRF == IPESystemValues.SW_NA)
	{
		STSADMTITDRF = 0;
	}
}}</bpmn:documentation>
