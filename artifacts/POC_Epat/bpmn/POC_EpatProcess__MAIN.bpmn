    <bpmn:intermediateCatchEvent id="_0XWagFqNEfG5K7mY0I3I6w" name="Inicia Graft Step">
      <bpmn:documentation>TIBCO id: _0XWagFqNEfG5K7mY0I3I6w | kind XPDL: linkCatch | faixa: ValidaoGraftStep</bpmn:documentation>
