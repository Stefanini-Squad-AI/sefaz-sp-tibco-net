    <bpmn:scriptTask id="_zE3XeV6JEfGBBLgT-R5iuw" name="prepSub">
      <bpmn:documentation>TIBCO id: _zE3XeV6JEfGBBLgT-R5iuw | kind XPDL: scriptTask | faixa: ValidaoParalelos | script: @{grammar=JavaScript; body=POSICAOINICIO = 0;
POSICAOFIM = 0;
AUX = IDSINTIMADOS;
for(INDICESUBDIN = 0; INDICESUBDIN &lt;= QTDINTIMADOS-1; INDICESUBDIN ++) {
	NRSUBPRO[INDICESUBDIN] = &quot;CONTROLE&quot;;
	POSICAOFIM = IPEStringUtil.SEARCH(&quot;|&quot;,AUX);
	ARRAYINT[INDICESUBDIN]=IPEStringUtil.SUBSTR(AUX,1,POSICAOFIM-1);
	POSICAOINICIO = POSICAOFIM+1;
    FIMSTRING = IPEStringUtil.STRLEN(AUX);
	AUX = IPEStringUtil.SUBSTR(AUX,POSICAOINICIO,FIMSTRING);
}
if (CODUADTJ == IPESystemValues.SW_NA){
	CODUADTJ = CODUADRT;
	}
/*if (CNTPECA1=='110' || CNTPECA1=='24' || CNTPECA1=='53' || CNTPECA1=='55' || CNTPECA1=='22'){
   IDPECASCNT = CNTPECA1;}*/

if(CNTPECA1 != IPESystemValues.SW_NA){
   	IDPECASCNT = CNTPECA1;}
   	
if(CNTPECA2 != IPESystemValues.SW_NA){
   	IDPECASCNT = IDPECASCNT + '|' + CNTPECA2;}
   	
if (CNTPECA3 != IPESystemValues.SW_NA){
   IDPECASCNT = IDPECASCNT + '|' + CNTPECA3;}

if (CNTPECA4 !=IPESystemValues.SW_NA){
   IDPECASCNT = IDPECASCNT + '|' + CNTPECA4;}


/*if (SFPECA1=='50' || SFPECA1=='24' || SFPECA1=='53' || SFPECA1=='49' || SFPECA1=='55' || SFPECA1=='110'){
   IDPECASSF = SFPECA1;}*/

if (SFPECA1 != IPESystemValues.SW_NA){
   IDPECASSF = SFPECA1;}

if (SFPECA2 != IPESystemValues.SW_NA){
   IDPECASSF = IDPECASSF + '|' + SFPECA2;}

if (SFPECA3 != IPESystemValues.SW_NA){
   IDPECASSF = IDPECASSF + '|' + SFPECA3;}

if (SFPECA4 != IPESystemValues.SW_NA){
   IDPECASSF = IDPECASSF + '|' + SFPECA4;}
   
   IDSINTIMADOS = '278713|278712|';
   /*--278711|278710|278709|278708|278707|278706|278705|278704|278703|278702|278701|278700|278699|278698|278697|278696|278695|278694|278693|278692|278691|';*/}</bpmn:documentation>
