    <bpmn:scriptTask id="_CI6lx1qREfG5K7mY0I3I6w" name="Verificar Anulacao">
      <bpmn:documentation>TIBCO id: _CI6lx1qREfG5K7mY0I3I6w | kind XPDL: scriptTask | faixa: ValidaoDecisions | script: @{grammar=JavaScript; body=if(ANULACAODTJ == true &amp;&amp; INSTANCIA == 2){
	STATUSRECURSOS = 0;
	if(INDNAORECORRER == true){
		INDNAORECORRER = true;
	}else if(INDNAORECORRER == false){
		INDNAORECORRER = false;
	}else{
		INDNAORECORRER = false;
	}
}
if(ORIGEM == IPESystemValues.SW_NA){
	ORIGEM = 'NA';
}
FLAGCRZ = FLAGCONTRARAZAO;}</bpmn:documentation>
