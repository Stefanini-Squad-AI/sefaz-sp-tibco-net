    <bpmn:boundaryEvent id="_EvOwRF6eEfGJqLUhfbpFcQ" name="Timer 1h" attachedToRef="_EvOwQl6eEfGJqLUhfbpFcQ" cancelActivity="true">
      <bpmn:documentation>TIBCO id: _EvOwRF6eEfGJqLUhfbpFcQ | kind XPDL: timerEvent | faixa: ProcessInterface | prazo: {&quot;grammar&quot;:&quot;ConstantPeriod&quot;,&quot;expression&quot;:null,&quot;days&quot;:&quot;&quot;,&quot;hours&quot;:&quot;1&quot;,&quot;minutes&quot;:&quot;&quot;}</bpmn:documentation>
      <bpmn:outgoing>F__EvOwa16eEfGJqLUhfbpFcQ</bpmn:outgoing>
      <bpmn:timerEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:scriptTask id="_EvOwTF6eEfGJqLUhfbpFcQ" name="Set Values">
      <bpmn:documentation>TIBCO id: _EvOwTF6eEfGJqLUhfbpFcQ | kind XPDL: scriptTask | faixa: ProcessInterface | script: @{grammar=JavaScript; body=FIELDSNAMES=&quot;procRetorno|caseRetorno|&quot;;
FIELDSTYPES=&quot;swText|swNumeric|&quot;;
FIELDSVALUES=IPESystemValues.SW_PRONAME + &quot;|&quot; + IPEConversionUtil.STR(IPESystemValues.SW_CASENUM,0) +&quot;|&quot;;

if (CNTPECA1!=IPESystemValues.SW_NA || CNTPECA1!='9') {
	IDPECAS = IDPECAS + CNTPECA1+ '|' ;
	}
if (CNTPECA2!=IPESystemValues.SW_NA) {
	IDPECAS = IDPECAS + CNTPECA2+ '|' ;
	}
if (CNTPECA3!=IPESystemValues.SW_NA) {
	IDPECAS = IDPECAS + CNTPECA3+ '|' ;
	}
if (CNTPECA4!=IPESystemValues.SW_NA) {
	IDPECAS = IDPECAS + CNTPECA4+ '|' ;
	}
PERIODOEMDIAS= IPEConversionUtil.NUM(TEMPORESPOSTA);}</bpmn:documentation>
