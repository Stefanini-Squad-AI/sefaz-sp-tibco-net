<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>SefazSp.Epat.Application</RootNamespace>
  </PropertyGroup>

  <!-- Regra da dependencia de Clean Architecture. Acrescentar referencia
       fora do mapa de config/dotnet-architecture.json e uma violacao. -->
  <ItemGroup>
    <ProjectReference Include="..\SefazSp.Epat.Domain\SefazSp.Epat.Domain.csproj" />
  </ItemGroup>

  <!-- Ficheiros de implementacao escritos pelos agentes em src/ -->
  <!-- ProcessExecutionContext.cs e fornecido pelo scaffold local; excluir da glob para evitar CS0101. -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\..\..\..\src\SefazSp.Epat.Application\Execution\*.cs"
             Exclude="$(MSBuildThisFileDirectory)..\..\..\..\..\..\src\SefazSp.Epat.Application\Execution\ProcessExecutionContext.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\..\..\..\src\SefazSp.Epat.Application\Workflows\*.cs" />
  </ItemGroup>

</Project>
