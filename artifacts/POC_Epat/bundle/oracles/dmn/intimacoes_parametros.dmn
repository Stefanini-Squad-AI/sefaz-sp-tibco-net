        <inputExpression id="InExpr_qtPecasCNT_18" typeRef="string">
          <text>Request.exclusaoSolidarios</text>
        </inputExpression>
      </input>
      <output id="Out_qtPecasCNT" label="QTPECASCNT (qtPecasCNT)" name="qtPecasCNT" typeRef="number" />
