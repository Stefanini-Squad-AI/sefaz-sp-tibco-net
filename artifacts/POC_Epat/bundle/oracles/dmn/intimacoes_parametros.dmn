<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" id="Defs_intimacoes_Parametros" name="intimacoes_Parametros" namespace="http://sefaz.sp.gov.br/poc_epat/dmn">
  <decision id="Decision_cntPeca1" name="cntPeca1">
    <description>Valor de cntPeca1. ATENCAO: esta tabela NAO reproduz a ordem original do Corticon. No Corticon todas as colunas que casam disparam, em ordem, e uma escrita posterior sobrepoe a anterior - portanto vale a ULTIMA coluna que escreve cntPeca1. Aqui as colunas foram INVERTIDAS e a politica e FIRST, o que e equivalente e nao admite leitura ambigua. A anotacao de cada linha traz o numero da coluna original no Corticon. Se nenhuma linha casar, cntPeca1 fica sem valor, o que no iProcess aparece como SW_NA.</description>
    <question>Qual o valor de </question>
    <variable id="Var_cntPeca1" name="cntPeca1" typeRef="string" />
    <decisionTable id="Table_cntPeca1" hitPolicy="FIRST">
      <input id="In_cntPeca1_0" label="INSTANCIA (instancia)">
        <inputExpression id="InExpr_cntPeca1_0" typeRef="string">
          <text>Request.instancia</text>
        </inputExpression>
      </input>
      <input id="In_cntPeca1_1" label="IDTIPOIMPUGNACA (tipoImpugnacao)">
        <inputExpression id="InExpr_cntPeca1_1" typeRef="string">
          <text>ResultadoJulgamento.request.tipoImpugnacao</text>
        </inputExpression>
      </input>
      <input id="In_cntPeca1_2" label="IDMOTIVOINTIMAC (motivoIntimacao)">
        <inputExpression id="InExpr_cntPeca1_2" typeRef="string">
          <text>ResultadoJulgamento.request.motivoIntimacao</text>
        </inputExpression>
      </input>
      <input id="In_cntPeca1_3" label="VICIOREPRESENTA (vicioRepresentacao)">
        <inputExpression id="InExpr_cntPeca1_3" typeRef="string">
          <text>ResultadoJulgamento.request.vicioRepresentacao</text>
        </inputExpression>
      </input>
      <input id="In_cntPeca1_4" label="DEFESAADMITIDA (defesaAdmitida)">
        <inputExpression id="InExpr_cntPeca1_4" typeRef="string">
          <text>ResultadoJulgamento.request.defesaAdmitida</text>
        </inputExpression>
      </input>
      <input id="In_cntPeca1_5" label="DILIGENCIA (diligencia)">
        <inputExpression id="InExpr_cntPeca1_5" typeRef="string">
          <text>ResultadoJulgamento.request.diligencia</text>
        </inputExpression>
      </input>
      <input id="In_cntPeca1_6" label="DILIGENCIADESTI (destinoDiligencia)">
        <inputExpression id="InExpr_cntPeca1_6" typeRef="string">
          <text>ResultadoJulgamento.request.destinoDiligencia</text>
        </inputExpression>
      </input>
      <input id="In_cntPeca1_7" label="IDDECISAOAIIM (idDecisaoAiim)">
        <inputExpression id="InExpr_cntPeca1_7" typeRef="string">
          <text>ResultadoJulgamento.request.idDecisaoAiim</text>
        </inputExpression>
      </input>
      <input id="In_cntPeca1_8" label="IDDECISAODEBITO (idDecisaoDebito)">
        <inputExpression id="InExpr_cntPeca1_8" typeRef="string">
          <text>ResultadoJulgamento.request.idDecisaoDebito</text>
        </inputExpression>
      </input>
      <input id="In_cntPeca1_9" label="RECURSOOFICIO (recursoOficio)">
        <inputExpression id="InExpr_cntPeca1_9" typeRef="string">
          <text>ResultadoJulgamento.request.recursoOficio</text>
        </inputExpression>
      </input>
      <input id="In_cntPeca1_10" label="FLAGCONTRARAZAO (contraRazao)">
        <inputExpression id="InExpr_cntPeca1_10" typeRef="string">
          <text>ResultadoJulgamento.request.contraRazao</text>
        </inputExpression>
      </input>
      <input id="In_cntPeca1_11" label="ORIGEM (origem)">
        <inputExpression id="InExpr_cntPeca1_11" typeRef="string">
          <text>ResultadoJulgamento.request.origem</text>
        </inputExpression>
      </input>
      <input id="In_cntPeca1_13" label="FLGALC (flgAlcada)">
        <inputExpression id="InExpr_cntPeca1_13" typeRef="string">
          <text>Request.flgAlcada</text>
        </inputExpression>
      </input>
      <input id="In_cntPeca1_14" label="STATUSRECURSOS (statusRecursos)">
        <inputExpression id="InExpr_cntPeca1_14" typeRef="string">
          <text>Request.statusRecursos</text>
        </inputExpression>
      </input>
      <input id="In_cntPeca1_15" label="STATUSPETICAO (statusPeticao)">
        <inputExpression id="InExpr_cntPeca1_15" typeRef="string">
          <text>ResultadoJulgamento.request.statusPeticao</text>
        </inputExpression>
      </input>
      <input id="In_cntPeca1_16" label="STATUSPRJ (statusPRJ)">
        <inputExpression id="InExpr_cntPeca1_16" typeRef="string">
          <text>Request.statusPRJ</text>
        </inputExpression>
      </input>
      <input id="In_cntPeca1_17" label="ANULACAODTJ (anulacaoDefesa)">
        <inputExpression id="InExpr_cntPeca1_17" typeRef="string">
          <text>Request.anulacaoDefesa</text>
        </inputExpression>
      </input>
      <input id="In_cntPeca1_18" label="EXCLUSAOSOLIDAR (exclusaoSolidarios)">
        <inputExpression id="InExpr_cntPeca1_18" typeRef="string">
          <text>Request.exclusaoSolidarios</text>
        </inputExpression>
      </input>
      <output id="Out_cntPeca1" label="CNTPECA1 (cntPeca1)" name="cntPeca1" typeRef="string" />
      <annotation name="coluna Corticon" />
