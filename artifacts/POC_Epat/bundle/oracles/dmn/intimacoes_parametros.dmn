      </input>
      <input id="In_codTexto_3" label="VICIOREPRESENTA (vicioRepresentacao)">
        <inputExpression id="InExpr_codTexto_3" typeRef="string">
          <text>ResultadoJulgamento.request.vicioRepresentacao</text>
        </inputExpression>
      </input>
      <input id="In_codTexto_4" label="DEFESAADMITIDA (defesaAdmitida)">
        <inputExpression id="InExpr_codTexto_4" typeRef="string">
          <text>ResultadoJulgamento.request.defesaAdmitida</text>
        </inputExpression>
