  <decision id="Decision_sfPeca3" name="sfPeca3">
    <description>Valor de sfPeca3. ATENCAO: esta tabela NAO reproduz a ordem original do Corticon. No Corticon todas as colunas que casam disparam, em ordem, e uma escrita posterior sobrepoe a anterior - portanto vale a ULTIMA coluna que escreve sfPeca3. Aqui as colunas foram INVERTIDAS e a politica e FIRST, o que e equivalente e nao admite leitura ambigua. A anotacao de cada linha traz o numero da coluna original no Corticon. Se nenhuma linha casar, sfPeca3 fica sem valor, o que no iProcess aparece como SW_NA.</description>
    <question>Qual o valor de </question>
    <variable id="Var_sfPeca3" name="sfPeca3" typeRef="string" />
    <decisionTable id="Table_sfPeca3" hitPolicy="FIRST">
      <input id="In_sfPeca3_0" label="INSTANCIA (instancia)">
        <inputExpression id="InExpr_sfPeca3_0" typeRef="string">
          <text>Request.instancia</text>
        </inputExpression>
      </input>
      <input id="In_sfPeca3_1" label="IDTIPOIMPUGNACA (tipoImpugnacao)">
        <inputExpression id="InExpr_sfPeca3_1" typeRef="string">
          <text>ResultadoJulgamento.request.tipoImpugnacao</text>
        </inputExpression>
      </input>
      <input id="In_sfPeca3_2" label="IDMOTIVOINTIMAC (motivoIntimacao)">
        <inputExpression id="InExpr_sfPeca3_2" typeRef="string">
          <text>ResultadoJulgamento.request.motivoIntimacao</text>
        </inputExpression>
      </input>
      <input id="In_sfPeca3_3" label="VICIOREPRESENTA (vicioRepresentacao)">
        <inputExpression id="InExpr_sfPeca3_3" typeRef="string">
          <text>ResultadoJulgamento.request.vicioRepresentacao</text>
        </inputExpression>
      </input>
      <input id="In_sfPeca3_8" label="IDDECISAODEBITO (idDecisaoDebito)">
        <inputExpression id="InExpr_sfPeca3_8" typeRef="string">
          <text>ResultadoJulgamento.request.idDecisaoDebito</text>
        </inputExpression>
      </input>
      <input id="In_sfPeca3_11" label="ORIGEM (origem)">
        <inputExpression id="InExpr_sfPeca3_11" typeRef="string">
          <text>ResultadoJulgamento.request.origem</text>
        </inputExpression>
      </input>
      <input id="In_sfPeca3_13" label="FLGALC (flgAlcada)">
        <inputExpression id="InExpr_sfPeca3_13" typeRef="string">
          <text>Request.flgAlcada</text>
        </inputExpression>
      </input>
      <input id="In_sfPeca3_14" label="STATUSRECURSOS (statusRecursos)">
        <inputExpression id="InExpr_sfPeca3_14" typeRef="string">
          <text>Request.statusRecursos</text>
        </inputExpression>
      </input>
      <input id="In_sfPeca3_17" label="ANULACAODTJ (anulacaoDefesa)">
        <inputExpression id="InExpr_sfPeca3_17" typeRef="string">
          <text>Request.anulacaoDefesa</text>
        </inputExpression>
      </input>
      <input id="In_sfPeca3_18" label="EXCLUSAOSOLIDAR (exclusaoSolidarios)">
        <inputExpression id="InExpr_sfPeca3_18" typeRef="string">
          <text>Request.exclusaoSolidarios</text>
        </inputExpression>
      </input>
      <output id="Out_sfPeca3" label="SFPECA3 (sfPeca3)" name="sfPeca3" typeRef="string" />
      <annotation name="coluna Corticon" />
      <rule id="Rule_sfPeca3_37">
        <description>coluna 37 - Segunda Instancia - RO - Decisao Anulada - Debito Mantido com exclusao de Solidario ou Debito Reduzido (37)</description>
