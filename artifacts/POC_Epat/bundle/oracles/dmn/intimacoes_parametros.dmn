      <input id="In_codTexto_5" label="DILIGENCIA (diligencia)">
        <inputExpression id="InExpr_codTexto_5" typeRef="string">
          <text>ResultadoJulgamento.request.diligencia</text>
        </inputExpression>
      </input>
      <input id="In_codTexto_6" label="DILIGENCIADESTI (destinoDiligencia)">
