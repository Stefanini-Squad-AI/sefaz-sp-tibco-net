  <decision id="Decision_qtPecasCNT" name="qtPecasCNT">
    <description>Valor de qtPecasCNT. ATENCAO: esta tabela NAO reproduz a ordem original do Corticon. No Corticon todas as colunas que casam disparam, em ordem, e uma escrita posterior sobrepoe a anterior - portanto vale a ULTIMA coluna que escreve qtPecasCNT. Aqui as colunas foram INVERTIDAS e a politica e FIRST, o que e equivalente e nao admite leitura ambigua. A anotacao de cada linha traz o numero da coluna original no Corticon. Se nenhuma linha casar, qtPecasCNT fica sem valor, o que no iProcess aparece como SW_NA.</description>
    <question>Qual o valor de </question>
    <variable id="Var_qtPecasCNT" name="qtPecasCNT" typeRef="number" />
    <decisionTable id="Table_qtPecasCNT" hitPolicy="FIRST">
      <input id="In_qtPecasCNT_0" label="INSTANCIA (instancia)">
        <inputExpression id="InExpr_qtPecasCNT_0" typeRef="string">
          <text>Request.instancia</text>
        </inputExpression>
      </input>
      <input id="In_qtPecasCNT_1" label="IDTIPOIMPUGNACA (tipoImpugnacao)">
        <inputExpression id="InExpr_qtPecasCNT_1" typeRef="string">
          <text>ResultadoJulgamento.request.tipoImpugnacao</text>
        </inputExpression>
      </input>
      <input id="In_qtPecasCNT_2" label="IDMOTIVOINTIMAC (motivoIntimacao)">
        <inputExpression id="InExpr_qtPecasCNT_2" typeRef="string">
          <text>ResultadoJulgamento.request.motivoIntimacao</text>
        </inputExpression>
      </input>
      <input id="In_qtPecasCNT_3" label="VICIOREPRESENTA (vicioRepresentacao)">
        <inputExpression id="InExpr_qtPecasCNT_3" typeRef="string">
          <text>ResultadoJulgamento.request.vicioRepresentacao</text>
        </inputExpression>
      </input>
      <input id="In_qtPecasCNT_4" label="DEFESAADMITIDA (defesaAdmitida)">
        <inputExpression id="InExpr_qtPecasCNT_4" typeRef="string">
          <text>ResultadoJulgamento.request.defesaAdmitida</text>
        </inputExpression>
      </input>
      <input id="In_qtPecasCNT_5" label="DILIGENCIA (diligencia)">
        <inputExpression id="InExpr_qtPecasCNT_5" typeRef="string">
          <text>ResultadoJulgamento.request.diligencia</text>
        </inputExpression>
      </input>
      <input id="In_qtPecasCNT_6" label="DILIGENCIADESTI (destinoDiligencia)">
        <inputExpression id="InExpr_qtPecasCNT_6" typeRef="string">
          <text>ResultadoJulgamento.request.destinoDiligencia</text>
        </inputExpression>
      </input>
      <input id="In_qtPecasCNT_7" label="IDDECISAOAIIM (idDecisaoAiim)">
        <inputExpression id="InExpr_qtPecasCNT_7" typeRef="string">
          <text>ResultadoJulgamento.request.idDecisaoAiim</text>
        </inputExpression>
      </input>
      <input id="In_qtPecasCNT_8" label="IDDECISAODEBITO (idDecisaoDebito)">
        <inputExpression id="InExpr_qtPecasCNT_8" typeRef="string">
          <text>ResultadoJulgamento.request.idDecisaoDebito</text>
        </inputExpression>
      </input>
      <input id="In_qtPecasCNT_9" label="RECURSOOFICIO (recursoOficio)">
        <inputExpression id="InExpr_qtPecasCNT_9" typeRef="string">
          <text>ResultadoJulgamento.request.recursoOficio</text>
        </inputExpression>
      </input>
      <input id="In_qtPecasCNT_10" label="FLAGCONTRARAZAO (contraRazao)">
        <inputExpression id="InExpr_qtPecasCNT_10" typeRef="string">
          <text>ResultadoJulgamento.request.contraRazao</text>
        </inputExpression>
      </input>
      <input id="In_qtPecasCNT_11" label="ORIGEM (origem)">
        <inputExpression id="InExpr_qtPecasCNT_11" typeRef="string">
          <text>ResultadoJulgamento.request.origem</text>
        </inputExpression>
      </input>
      <input id="In_qtPecasCNT_13" label="FLGALC (flgAlcada)">
        <inputExpression id="InExpr_qtPecasCNT_13" typeRef="string">
          <text>Request.flgAlcada</text>
        </inputExpression>
      </input>
      <input id="In_qtPecasCNT_14" label="STATUSRECURSOS (statusRecursos)">
        <inputExpression id="InExpr_qtPecasCNT_14" typeRef="string">
          <text>Request.statusRecursos</text>
        </inputExpression>
      </input>
      <input id="In_qtPecasCNT_15" label="STATUSPETICAO (statusPeticao)">
        <inputExpression id="InExpr_qtPecasCNT_15" typeRef="string">
          <text>ResultadoJulgamento.request.statusPeticao</text>
        </inputExpression>
      </input>
      <input id="In_qtPecasCNT_16" label="STATUSPRJ (statusPRJ)">
        <inputExpression id="InExpr_qtPecasCNT_16" typeRef="string">
          <text>Request.statusPRJ</text>
        </inputExpression>
      </input>
      <input id="In_qtPecasCNT_17" label="ANULACAODTJ (anulacaoDefesa)">
        <inputExpression id="InExpr_qtPecasCNT_17" typeRef="string">
          <text>Request.anulacaoDefesa</text>
        </inputExpression>
      </input>
