  <decision id="Decision_contraRazao" name="contraRazao">
    <description>Valor de contraRazao. ATENCAO: esta tabela NAO reproduz a ordem original do Corticon. No Corticon todas as colunas que casam disparam, em ordem, e uma escrita posterior sobrepoe a anterior - portanto vale a ULTIMA coluna que escreve contraRazao. Aqui as colunas foram INVERTIDAS e a politica e FIRST, o que e equivalente e nao admite leitura ambigua. A anotacao de cada linha traz o numero da coluna original no Corticon. Se nenhuma linha casar, contraRazao fica sem valor, o que no iProcess aparece como SW_NA.</description>
    <question>Qual o valor de </question>
    <variable id="Var_contraRazao" name="contraRazao" typeRef="string" />
    <decisionTable id="Table_contraRazao" hitPolicy="FIRST">
      <input id="In_contraRazao_0" label="INSTANCIA (instancia)">
        <inputExpression id="InExpr_contraRazao_0" typeRef="string">
          <text>Request.instancia</text>
        </inputExpression>
      </input>
      <input id="In_contraRazao_1" label="IDTIPOIMPUGNACA (tipoImpugnacao)">
        <inputExpression id="InExpr_contraRazao_1" typeRef="string">
          <text>ResultadoJulgamento.request.tipoImpugnacao</text>
        </inputExpression>
      </input>
      <input id="In_contraRazao_2" label="IDMOTIVOINTIMAC (motivoIntimacao)">
        <inputExpression id="InExpr_contraRazao_2" typeRef="string">
          <text>ResultadoJulgamento.request.motivoIntimacao</text>
        </inputExpression>
      </input>
      <input id="In_contraRazao_3" label="VICIOREPRESENTA (vicioRepresentacao)">
        <inputExpression id="InExpr_contraRazao_3" typeRef="string">
          <text>ResultadoJulgamento.request.vicioRepresentacao</text>
        </inputExpression>
      </input>
      <input id="In_contraRazao_4" label="DEFESAADMITIDA (defesaAdmitida)">
        <inputExpression id="InExpr_contraRazao_4" typeRef="string">
          <text>ResultadoJulgamento.request.defesaAdmitida</text>
        </inputExpression>
      </input>
      <input id="In_contraRazao_5" label="DILIGENCIA (diligencia)">
        <inputExpression id="InExpr_contraRazao_5" typeRef="string">
          <text>ResultadoJulgamento.request.diligencia</text>
        </inputExpression>
      </input>
      <input id="In_contraRazao_6" label="DILIGENCIADESTI (destinoDiligencia)">
        <inputExpression id="InExpr_contraRazao_6" typeRef="string">
          <text>ResultadoJulgamento.request.destinoDiligencia</text>
        </inputExpression>
      </input>
      <input id="In_contraRazao_7" label="IDDECISAOAIIM (idDecisaoAiim)">
        <inputExpression id="InExpr_contraRazao_7" typeRef="string">
          <text>ResultadoJulgamento.request.idDecisaoAiim</text>
        </inputExpression>
      </input>
      <input id="In_contraRazao_8" label="IDDECISAODEBITO (idDecisaoDebito)">
        <inputExpression id="InExpr_contraRazao_8" typeRef="string">
          <text>ResultadoJulgamento.request.idDecisaoDebito</text>
        </inputExpression>
      </input>
      <input id="In_contraRazao_9" label="RECURSOOFICIO (recursoOficio)">
        <inputExpression id="InExpr_contraRazao_9" typeRef="string">
          <text>ResultadoJulgamento.request.recursoOficio</text>
        </inputExpression>
      </input>
      <input id="In_contraRazao_10" label="FLAGCONTRARAZAO (contraRazao)">
        <inputExpression id="InExpr_contraRazao_10" typeRef="string">
          <text>ResultadoJulgamento.request.contraRazao</text>
        </inputExpression>
      </input>
      <input id="In_contraRazao_11" label="ORIGEM (origem)">
        <inputExpression id="InExpr_contraRazao_11" typeRef="string">
          <text>ResultadoJulgamento.request.origem</text>
        </inputExpression>
      </input>
      <input id="In_contraRazao_13" label="FLGALC (flgAlcada)">
        <inputExpression id="InExpr_contraRazao_13" typeRef="string">
          <text>Request.flgAlcada</text>
        </inputExpression>
      </input>
      <input id="In_contraRazao_14" label="STATUSRECURSOS (statusRecursos)">
        <inputExpression id="InExpr_contraRazao_14" typeRef="string">
          <text>Request.statusRecursos</text>
        </inputExpression>
      </input>
      <input id="In_contraRazao_16" label="STATUSPRJ (statusPRJ)">
        <inputExpression id="InExpr_contraRazao_16" typeRef="string">
          <text>Request.statusPRJ</text>
        </inputExpression>
      </input>
      <input id="In_contraRazao_17" label="ANULACAODTJ (anulacaoDefesa)">
        <inputExpression id="InExpr_contraRazao_17" typeRef="string">
          <text>Request.anulacaoDefesa</text>
        </inputExpression>
      </input>
      <input id="In_contraRazao_18" label="EXCLUSAOSOLIDAR (exclusaoSolidarios)">
        <inputExpression id="InExpr_contraRazao_18" typeRef="string">
          <text>Request.exclusaoSolidarios</text>
        </inputExpression>
      </input>
      <output id="Out_contraRazao" label="FLAGCONTRARAZAO (contraRazao)" name="contraRazao" typeRef="string" />
      <annotation name="coluna Corticon" />
