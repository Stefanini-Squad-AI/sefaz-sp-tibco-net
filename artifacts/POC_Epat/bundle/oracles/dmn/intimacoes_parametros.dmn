  <decision id="Decision_sfDiasRepresentacao" name="sfDiasRepresentacao">
    <description>Valor de sfDiasRepresentacao. ATENCAO: esta tabela NAO reproduz a ordem original do Corticon. No Corticon todas as colunas que casam disparam, em ordem, e uma escrita posterior sobrepoe a anterior - portanto vale a ULTIMA coluna que escreve sfDiasRepresentacao. Aqui as colunas foram INVERTIDAS e a politica e FIRST, o que e equivalente e nao admite leitura ambigua. A anotacao de cada linha traz o numero da coluna original no Corticon. Se nenhuma linha casar, sfDiasRepresentacao fica sem valor, o que no iProcess aparece como SW_NA.</description>
    <question>Qual o valor de </question>
    <variable id="Var_sfDiasRepresentacao" name="sfDiasRepresentacao" typeRef="string" />
    <decisionTable id="Table_sfDiasRepresentacao" hitPolicy="FIRST">
      <input id="In_sfDiasRepresentacao_0" label="INSTANCIA (instancia)">
        <inputExpression id="InExpr_sfDiasRepresentacao_0" typeRef="string">
          <text>Request.instancia</text>
        </inputExpression>
      </input>
      <input id="In_sfDiasRepresentacao_1" label="IDTIPOIMPUGNACA (tipoImpugnacao)">
        <inputExpression id="InExpr_sfDiasRepresentacao_1" typeRef="string">
          <text>ResultadoJulgamento.request.tipoImpugnacao</text>
        </inputExpression>
      </input>
      <input id="In_sfDiasRepresentacao_2" label="IDMOTIVOINTIMAC (motivoIntimacao)">
        <inputExpression id="InExpr_sfDiasRepresentacao_2" typeRef="string">
          <text>ResultadoJulgamento.request.motivoIntimacao</text>
        </inputExpression>
      </input>
      <input id="In_sfDiasRepresentacao_3" label="VICIOREPRESENTA (vicioRepresentacao)">
        <inputExpression id="InExpr_sfDiasRepresentacao_3" typeRef="string">
          <text>ResultadoJulgamento.request.vicioRepresentacao</text>
        </inputExpression>
      </input>
      <input id="In_sfDiasRepresentacao_4" label="DEFESAADMITIDA (defesaAdmitida)">
        <inputExpression id="InExpr_sfDiasRepresentacao_4" typeRef="string">
          <text>ResultadoJulgamento.request.defesaAdmitida</text>
        </inputExpression>
      </input>
      <input id="In_sfDiasRepresentacao_5" label="DILIGENCIA (diligencia)">
        <inputExpression id="InExpr_sfDiasRepresentacao_5" typeRef="string">
          <text>ResultadoJulgamento.request.diligencia</text>
        </inputExpression>
      </input>
      <input id="In_sfDiasRepresentacao_6" label="DILIGENCIADESTI (destinoDiligencia)">
        <inputExpression id="InExpr_sfDiasRepresentacao_6" typeRef="string">
          <text>ResultadoJulgamento.request.destinoDiligencia</text>
        </inputExpression>
      </input>
      <input id="In_sfDiasRepresentacao_7" label="IDDECISAOAIIM (idDecisaoAiim)">
        <inputExpression id="InExpr_sfDiasRepresentacao_7" typeRef="string">
          <text>ResultadoJulgamento.request.idDecisaoAiim</text>
        </inputExpression>
      </input>
      <input id="In_sfDiasRepresentacao_8" label="IDDECISAODEBITO (idDecisaoDebito)">
        <inputExpression id="InExpr_sfDiasRepresentacao_8" typeRef="string">
          <text>ResultadoJulgamento.request.idDecisaoDebito</text>
        </inputExpression>
      </input>
      <input id="In_sfDiasRepresentacao_9" label="RECURSOOFICIO (recursoOficio)">
