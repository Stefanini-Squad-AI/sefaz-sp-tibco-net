  <decision id="Decision_cntPeca2" name="cntPeca2">
    <description>Valor de cntPeca2. ATENCAO: esta tabela NAO reproduz a ordem original do Corticon. No Corticon todas as colunas que casam disparam, em ordem, e uma escrita posterior sobrepoe a anterior - portanto vale a ULTIMA coluna que escreve cntPeca2. Aqui as colunas foram INVERTIDAS e a politica e FIRST, o que e equivalente e nao admite leitura ambigua. A anotacao de cada linha traz o numero da coluna original no Corticon. Se nenhuma linha casar, cntPeca2 fica sem valor, o que no iProcess aparece como SW_NA.</description>
    <question>Qual o valor de </question>
    <variable id="Var_cntPeca2" name="cntPeca2" typeRef="string" />
    <decisionTable id="Table_cntPeca2" hitPolicy="FIRST">
      <input id="In_cntPeca2_0" label="INSTANCIA (instancia)">
        <inputExpression id="InExpr_cntPeca2_0" typeRef="string">
          <text>Request.instancia</text>
        </inputExpression>
      </input>
      <input id="In_cntPeca2_1" label="IDTIPOIMPUGNACA (tipoImpugnacao)">
        <inputExpression id="InExpr_cntPeca2_1" typeRef="string">
          <text>ResultadoJulgamento.request.tipoImpugnacao</text>
        </inputExpression>
      </input>
      <input id="In_cntPeca2_2" label="IDMOTIVOINTIMAC (motivoIntimacao)">
        <inputExpression id="InExpr_cntPeca2_2" typeRef="string">
          <text>ResultadoJulgamento.request.motivoIntimacao</text>
        </inputExpression>
      </input>
      <input id="In_cntPeca2_3" label="VICIOREPRESENTA (vicioRepresentacao)">
        <inputExpression id="InExpr_cntPeca2_3" typeRef="string">
          <text>ResultadoJulgamento.request.vicioRepresentacao</text>
        </inputExpression>
      </input>
      <input id="In_cntPeca2_4" label="DEFESAADMITIDA (defesaAdmitida)">
        <inputExpression id="InExpr_cntPeca2_4" typeRef="string">
          <text>ResultadoJulgamento.request.defesaAdmitida</text>
        </inputExpression>
      </input>
      <input id="In_cntPeca2_5" label="DILIGENCIA (diligencia)">
        <inputExpression id="InExpr_cntPeca2_5" typeRef="string">
          <text>ResultadoJulgamento.request.diligencia</text>
        </inputExpression>
      </input>
      <input id="In_cntPeca2_7" label="IDDECISAOAIIM (idDecisaoAiim)">
        <inputExpression id="InExpr_cntPeca2_7" typeRef="string">
          <text>ResultadoJulgamento.request.idDecisaoAiim</text>
        </inputExpression>
      </input>
      <input id="In_cntPeca2_8" label="IDDECISAODEBITO (idDecisaoDebito)">
        <inputExpression id="InExpr_cntPeca2_8" typeRef="string">
          <text>ResultadoJulgamento.request.idDecisaoDebito</text>
        </inputExpression>
      </input>
      <input id="In_cntPeca2_9" label="RECURSOOFICIO (recursoOficio)">
        <inputExpression id="InExpr_cntPeca2_9" typeRef="string">
          <text>ResultadoJulgamento.request.recursoOficio</text>
        </inputExpression>
      </input>
      <input id="In_cntPeca2_10" label="FLAGCONTRARAZAO (contraRazao)">
        <inputExpression id="InExpr_cntPeca2_10" typeRef="string">
          <text>ResultadoJulgamento.request.contraRazao</text>
        </inputExpression>
      </input>
      <input id="In_cntPeca2_11" label="ORIGEM (origem)">
        <inputExpression id="InExpr_cntPeca2_11" typeRef="string">
          <text>ResultadoJulgamento.request.origem</text>
        </inputExpression>
      </input>
      <input id="In_cntPeca2_13" label="FLGALC (flgAlcada)">
        <inputExpression id="InExpr_cntPeca2_13" typeRef="string">
          <text>Request.flgAlcada</text>
        </inputExpression>
      </input>
      <input id="In_cntPeca2_14" label="STATUSRECURSOS (statusRecursos)">
        <inputExpression id="InExpr_cntPeca2_14" typeRef="string">
          <text>Request.statusRecursos</text>
