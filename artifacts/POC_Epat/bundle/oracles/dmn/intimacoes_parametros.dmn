  <decision id="Decision_sfPeca1" name="sfPeca1">
    <description>Valor de sfPeca1. ATENCAO: esta tabela NAO reproduz a ordem original do Corticon. No Corticon todas as colunas que casam disparam, em ordem, e uma escrita posterior sobrepoe a anterior - portanto vale a ULTIMA coluna que escreve sfPeca1. Aqui as colunas foram INVERTIDAS e a politica e FIRST, o que e equivalente e nao admite leitura ambigua. A anotacao de cada linha traz o numero da coluna original no Corticon. Se nenhuma linha casar, sfPeca1 fica sem valor, o que no iProcess aparece como SW_NA.</description>
    <question>Qual o valor de </question>
    <variable id="Var_sfPeca1" name="sfPeca1" typeRef="string" />
    <decisionTable id="Table_sfPeca1" hitPolicy="FIRST">
      <input id="In_sfPeca1_0" label="INSTANCIA (instancia)">
        <inputExpression id="InExpr_sfPeca1_0" typeRef="string">
          <text>Request.instancia</text>
        </inputExpression>
      </input>
      <input id="In_sfPeca1_1" label="IDTIPOIMPUGNACA (tipoImpugnacao)">
        <inputExpression id="InExpr_sfPeca1_1" typeRef="string">
          <text>ResultadoJulgamento.request.tipoImpugnacao</text>
        </inputExpression>
      </input>
      <input id="In_sfPeca1_2" label="IDMOTIVOINTIMAC (motivoIntimacao)">
        <inputExpression id="InExpr_sfPeca1_2" typeRef="string">
          <text>ResultadoJulgamento.request.motivoIntimacao</text>
        </inputExpression>
      </input>
      <input id="In_sfPeca1_3" label="VICIOREPRESENTA (vicioRepresentacao)">
        <inputExpression id="InExpr_sfPeca1_3" typeRef="string">
          <text>ResultadoJulgamento.request.vicioRepresentacao</text>
        </inputExpression>
      </input>
      <input id="In_sfPeca1_4" label="DEFESAADMITIDA (defesaAdmitida)">
        <inputExpression id="InExpr_sfPeca1_4" typeRef="string">
          <text>ResultadoJulgamento.request.defesaAdmitida</text>
        </inputExpression>
      </input>
      <input id="In_sfPeca1_5" label="DILIGENCIA (diligencia)">
        <inputExpression id="InExpr_sfPeca1_5" typeRef="string">
          <text>ResultadoJulgamento.request.diligencia</text>
        </inputExpression>
      </input>
      <input id="In_sfPeca1_6" label="DILIGENCIADESTI (destinoDiligencia)">
        <inputExpression id="InExpr_sfPeca1_6" typeRef="string">
          <text>ResultadoJulgamento.request.destinoDiligencia</text>
        </inputExpression>
      </input>
      <input id="In_sfPeca1_7" label="IDDECISAOAIIM (idDecisaoAiim)">
        <inputExpression id="InExpr_sfPeca1_7" typeRef="string">
          <text>ResultadoJulgamento.request.idDecisaoAiim</text>
        </inputExpression>
      </input>
      <input id="In_sfPeca1_8" label="IDDECISAODEBITO (idDecisaoDebito)">
        <inputExpression id="InExpr_sfPeca1_8" typeRef="string">
          <text>ResultadoJulgamento.request.idDecisaoDebito</text>
        </inputExpression>
      </input>
      <input id="In_sfPeca1_9" label="RECURSOOFICIO (recursoOficio)">
        <inputExpression id="InExpr_sfPeca1_9" typeRef="string">
          <text>ResultadoJulgamento.request.recursoOficio</text>
        </inputExpression>
      </input>
      <input id="In_sfPeca1_10" label="FLAGCONTRARAZAO (contraRazao)">
        <inputExpression id="InExpr_sfPeca1_10" typeRef="string">
          <text>ResultadoJulgamento.request.contraRazao</text>
        </inputExpression>
      </input>
      <input id="In_sfPeca1_11" label="ORIGEM (origem)">
        <inputExpression id="InExpr_sfPeca1_11" typeRef="string">
          <text>ResultadoJulgamento.request.origem</text>
        </inputExpression>
      </input>
      <input id="In_sfPeca1_13" label="FLGALC (flgAlcada)">
        <inputExpression id="InExpr_sfPeca1_13" typeRef="string">
          <text>Request.flgAlcada</text>
        </inputExpression>
      </input>
      <input id="In_sfPeca1_14" label="STATUSRECURSOS (statusRecursos)">
        <inputExpression id="InExpr_sfPeca1_14" typeRef="string">
          <text>Request.statusRecursos</text>
        </inputExpression>
      </input>
      <input id="In_sfPeca1_15" label="STATUSPETICAO (statusPeticao)">
        <inputExpression id="InExpr_sfPeca1_15" typeRef="string">
          <text>ResultadoJulgamento.request.statusPeticao</text>
        </inputExpression>
      </input>
      <input id="In_sfPeca1_17" label="ANULACAODTJ (anulacaoDefesa)">
        <inputExpression id="InExpr_sfPeca1_17" typeRef="string">
          <text>Request.anulacaoDefesa</text>
        </inputExpression>
      </input>
      <input id="In_sfPeca1_18" label="EXCLUSAOSOLIDAR (exclusaoSolidarios)">
        <inputExpression id="InExpr_sfPeca1_18" typeRef="string">
          <text>Request.exclusaoSolidarios</text>
        </inputExpression>
      </input>
      <output id="Out_sfPeca1" label="SFPECA1 (sfPeca1)" name="sfPeca1" typeRef="string" />
