      <output id="MOut_qtPecasSefaz" label="QTPECASSEFAZ (qtPecasSefaz)" name="qtPecasSefaz" typeRef="number" />
      <output id="MOut_sfDiasRepresentacao" label="SFDIASREPRESENT (sfDiasRepresentacao)" name="sfDiasRepresentacao" typeRef="string" />
      <output id="MOut_sfPeca1" label="SFPECA1 (sfPeca1)" name="sfPeca1" typeRef="string" />
      <output id="MOut_sfPeca2" label="SFPECA2 (sfPeca2)" name="sfPeca2" typeRef="string" />
