<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" id="Defs_intimacoes_Parametros_Espelho" name="intimacoes_Parametros - espelho do rulesheet" namespace="http://sefaz.sp.gov.br/poc_epat/dmn">
  <decision id="Decision_Espelho" name="Espelho do rulesheet Corticon">
    <description>ESPELHO 1:1 do rulesheet Corticon (49 colunas x 21 condicoes), para rastreabilidade contra o .ers original. NAO USE ESTA TABELA PARA REVISAR COMPORTAMENTO. A politica RULE ORDER devolve a LISTA das linhas que casam, na ordem, e nao expressa a sobreposicao: no Corticon uma escrita posterior sobrepoe a anterior. Alem disso a celula vazia (null) aqui significa &quot;esta coluna nao escreve este atributo&quot;, e NAO &quot;define como nulo&quot;. Para revisar comportamento use intimacoes_parametros.dmn, onde cada atributo vira uma decisao FIRST equivalente.</description>
    <decisionTable id="Table_Espelho" hitPolicy="RULE ORDER">
      <input id="MIn_0" label="INSTANCIA (instancia)">
        <inputExpression id="MInExpr_0" typeRef="string">
          <text>Request.instancia</text>
        </inputExpression>
      </input>
      <input id="MIn_1" label="IDTIPOIMPUGNACA (tipoImpugnacao)">
        <inputExpression id="MInExpr_1" typeRef="string">
          <text>ResultadoJulgamento.request.tipoImpugnacao</text>
        </inputExpression>
      </input>
      <input id="MIn_2" label="IDMOTIVOINTIMAC (motivoIntimacao)">
        <inputExpression id="MInExpr_2" typeRef="string">
          <text>ResultadoJulgamento.request.motivoIntimacao</text>
        </inputExpression>
      </input>
      <input id="MIn_3" label="VICIOREPRESENTA (vicioRepresentacao)">
        <inputExpression id="MInExpr_3" typeRef="string">
          <text>ResultadoJulgamento.request.vicioRepresentacao</text>
        </inputExpression>
      </input>
      <input id="MIn_4" label="DEFESAADMITIDA (defesaAdmitida)">
        <inputExpression id="MInExpr_4" typeRef="string">
          <text>ResultadoJulgamento.request.defesaAdmitida</text>
        </inputExpression>
      </input>
      <input id="MIn_5" label="DILIGENCIA (diligencia)">
        <inputExpression id="MInExpr_5" typeRef="string">
          <text>ResultadoJulgamento.request.diligencia</text>
        </inputExpression>
      </input>
      <input id="MIn_6" label="DILIGENCIADESTI (destinoDiligencia)">
        <inputExpression id="MInExpr_6" typeRef="string">
          <text>ResultadoJulgamento.request.destinoDiligencia</text>
        </inputExpression>
      </input>
      <input id="MIn_7" label="IDDECISAOAIIM (idDecisaoAiim)">
        <inputExpression id="MInExpr_7" typeRef="string">
          <text>ResultadoJulgamento.request.idDecisaoAiim</text>
        </inputExpression>
      </input>
      <input id="MIn_8" label="IDDECISAODEBITO (idDecisaoDebito)">
        <inputExpression id="MInExpr_8" typeRef="string">
          <text>ResultadoJulgamento.request.idDecisaoDebito</text>
        </inputExpression>
      </input>
      <input id="MIn_9" label="RECURSOOFICIO (recursoOficio)">
        <inputExpression id="MInExpr_9" typeRef="string">
          <text>ResultadoJulgamento.request.recursoOficio</text>
        </inputExpression>
      </input>
      <input id="MIn_10" label="FLAGCONTRARAZAO (contraRazao)">
        <inputExpression id="MInExpr_10" typeRef="string">
          <text>ResultadoJulgamento.request.contraRazao</text>
        </inputExpression>
      </input>
      <input id="MIn_11" label="ORIGEM (origem)">
        <inputExpression id="MInExpr_11" typeRef="string">
          <text>ResultadoJulgamento.request.origem</text>
        </inputExpression>
      </input>
      <input id="MIn_13" label="FLGALC (flgAlcada)">
        <inputExpression id="MInExpr_13" typeRef="string">
          <text>Request.flgAlcada</text>
        </inputExpression>
      </input>
      <input id="MIn_14" label="STATUSRECURSOS (statusRecursos)">
        <inputExpression id="MInExpr_14" typeRef="string">
          <text>Request.statusRecursos</text>
        </inputExpression>
      </input>
      <input id="MIn_15" label="STATUSPETICAO (statusPeticao)">
        <inputExpression id="MInExpr_15" typeRef="string">
          <text>ResultadoJulgamento.request.statusPeticao</text>
        </inputExpression>
      </input>
      <input id="MIn_16" label="STATUSPRJ (statusPRJ)">
        <inputExpression id="MInExpr_16" typeRef="string">
          <text>Request.statusPRJ</text>
        </inputExpression>
      </input>
      <input id="MIn_17" label="ANULACAODTJ (anulacaoDefesa)">
        <inputExpression id="MInExpr_17" typeRef="string">
          <text>Request.anulacaoDefesa</text>
        </inputExpression>
      </input>
      <input id="MIn_18" label="EXCLUSAOSOLIDAR (exclusaoSolidarios)">
        <inputExpression id="MInExpr_18" typeRef="string">
          <text>Request.exclusaoSolidarios</text>
        </inputExpression>
      </input>
      <input id="MIn_19" label="INDRESPPRM (existeRespPRM)">
        <inputExpression id="MInExpr_19" typeRef="string">
