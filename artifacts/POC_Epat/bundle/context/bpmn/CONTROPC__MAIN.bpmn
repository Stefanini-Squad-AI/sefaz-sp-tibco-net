    <bpmn:scriptTask id="_-bkw_V6JEfGBBLgT-R5iuw" name="Controle de Prazos">
      <bpmn:documentation>TIBCO id: _-bkw_V6JEfGBBLgT-R5iuw | kind XPDL: scriptTask | faixa: Servicos | script: @{grammar=JavaScript; body=if (DSTIPOINTIMACAO==&quot;Carta com AR&quot;){
   PERIODOEMDIAS=360;}
else if (DSTIPOINTIMACAO==&quot;DE&quot;){
	PRAZOCIENCIA = DTPUBLICACAODE;
	PERIODOEMDIAS=0;
	}
else {
	PERIODOEMDIAS=10;
	}


NOVOMODELO == true;}</bpmn:documentation>
