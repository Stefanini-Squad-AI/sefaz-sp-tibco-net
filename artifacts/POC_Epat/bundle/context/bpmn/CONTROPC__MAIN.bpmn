    </bpmn:endEvent>
    <bpmn:scriptTask id="_-bkw-F6JEfGBBLgT-R5iuw" name="ISetSubProc">
      <bpmn:documentation>TIBCO id: _-bkw-F6JEfGBBLgT-R5iuw | kind XPDL: scriptTask | faixa: Servicos | script: @{grammar=JavaScript; body=//idmotivos7
//1 - Decisao
//2 - Vicio
//3 - Diligencia
//
//iddeciaodebito
// 1 mantido
// 2 reduzido
// 3 cancelado
//

if(IDMOTIVOINTIMAC == 1){
	if ((IDDECISAODEBITO == 3 || IDDECISAODEBITO == 0) &amp;&amp; DEFESAADMITIDA == true)
		{AGUARDAR[0] = &quot;AgPRJ&quot;;}
	else if (IDDECISAODEBITO == 0 &amp;&amp; DEFESAADMITIDA == false)
		{AGUARDAR[0] = &quot;AgRecPRJ&quot;;}	
	
	if (IDDECISAODEBITO == 1 || IDDECISAODEBITO == 2){
		if (RECURSOOFICIO == true)
		{AGUARDAR[0] = &quot;AgPRJ&quot;;}
		else if (RECURSOOFICIO == false)
		{AGUARDAR[0] = &quot;AgRecPRJ&quot;;}
	}
	if (IDTIPOIMPUGNACA == '4' )
		{AGUARDAR[0] = &quot;AgPRJR&quot;;}
}
//falta implementar regras para PRJ
if (IDMOTIVOINTIMAC == 2){
	AGUARDAR[0] = &quot;AgPecas&quot;;
} 
if (CRCONTRIBUINTE == 1 ){
	if (IDDECISAODEBITO == 1 || IDDECISAODEBITO == 2 &amp;&amp; RECURSOOFICIO==true){
		AGUARDAR[0] = &quot;AgRCRaz&quot;;}
	else {
		AGUARDAR[0] = &quot;AgCRaz&quot;;}
	}


if (DILIGENCIA == true){
	AGUARDAR[0] = &quot;AgPetica&quot;;
}
PROCRETORNO = AGUARDAR[0];

//alterado para verificar se a intimacao teve ciencia, se nao houver considerar a data da publicacao.
if (DSTIPOINTIMACAO=='DE' || DTCIENCIA==IPESystemValues.SW_NA )
	{DTCIENCIA=DTPUBLICACAODE;}


//if (Instancia==2 || vicioRepresentacao == true || (Instancia == 1 &amp;&amp; defesaAdmitida == false &amp;&amp; diligencia!=true) ){
if (NOVOMODELO == true) {
	AGUARDAR[0] = &quot;AgPecas&quot;;
	PROCRETORNO = AGUARDAR[0];
	}}</bpmn:documentation>
      <bpmn:incoming>F__hBNA0F6NEfGBBLgT-R5iuw</bpmn:incoming>
      <bpmn:outgoing>F__-bkxSF6JEfGBBLgT-R5iuw</bpmn:outgoing>
    </bpmn:scriptTask>
