<sw:ExtAttr Name="Annotation">
<sw:Annotation>
<sw:AnnotText>Servico de consulta ao motor de regras para captura dos prazos, pecas, envolvidos e texto.
--------------------------------------
Parameters:
======================================
$ipmFldName  (IDPROCESSO)
$ipmFldName  (IDAIIM)
$ipmFldName  (VICIOREPRESENTA)
$ipmFldName  (IDTIPOIMPUGNACA)
