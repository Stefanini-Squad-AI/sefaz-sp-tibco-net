<xpdl:Application Id="3IPMF" Name="EAISCRIPT">
<xpdl:Description>SETVALUE</xpdl:Description>
<xpdl:FormalParameters/>
<xpdl:ExtendedAttributes>
<xpdl:ExtendedAttribute Name="ExtAttr">
<sw:ExtAttr Name="EAIRunType" xmlns="http://bpm.tibco.com/2004/SWSPDXML2.0">
<sw:EAIRunType>EAISCRIPT</sw:EAIRunType>
</sw:ExtAttr>
</xpdl:ExtendedAttribute>
<xpdl:ExtendedAttribute Name="ExtAttr">
<sw:ExtAttr Name="EAIData" xmlns="http://bpm.tibco.com/2004/SWSPDXML2.0">
<sw:EAIData TypeDataIncomplete="false">
<sw:EAIRunData>
<sw:EAITypeData>
<sw:EAIText>FIELDSNAMES:="procRetorno|caseRetorno|"

FIELDSTYPES:="swText|swNumeric|"

FIELDSVALUES:=SW_PRONAME+"|"+STR(SW_CASENUM,0)+"|"

IF CNTPECA1&lt;&gt;SW_NA OR CNTPECA1&lt;&gt;"9"  
	IDPECAS:=IDPECAS+CNTPECA1+"|"
ENDIF

IF CNTPECA2&lt;&gt;SW_NA  
	IDPECAS:=IDPECAS+CNTPECA2+"|"
ENDIF

IF CNTPECA3&lt;&gt;SW_NA  
	IDPECAS:=IDPECAS+CNTPECA3+"|"
ENDIF

IF CNTPECA4&lt;&gt;SW_NA  
	IDPECAS:=IDPECAS+CNTPECA4+"|"
ENDIF

PERIODOEMDIAS:=NUM(TEMPORESPOSTA)</sw:EAIText>
</sw:EAITypeData>
</sw:EAIRunData>
</sw:EAIData>
</sw:ExtAttr>
</xpdl:ExtendedAttribute>
</xpdl:ExtendedAttributes>
</xpdl:Application>
