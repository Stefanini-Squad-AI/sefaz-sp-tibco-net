<xpdl:Application Id="28IPMF" Name="EAISCRIPT">
<xpdl:Description>VRFANULA</xpdl:Description>
<xpdl:FormalParameters/>
<xpdl:ExtendedAttributes>
<xpdl:ExtendedAttribute Name="ExtAttr">
<sw:ExtAttr Name="EAIRunType" xmlns="http://bpm.tibco.com/2004/SWSPDXML2.0">
<sw:EAIRunType>EAISCRIPT</sw:EAIRunType>
</sw:ExtAttr>
</xpdl:ExtendedAttribute>
<xpdl:ExtendedAttribute Name="ExtAttr">
<sw:ExtAttr Name="EAIData" xmlns="http://bpm.tibco.com/2004/SWSPDXML2.0">
<sw:EAIData TypeDataIncomplete="false">
<sw:EAIRunData>
<sw:EAITypeData>
<sw:EAIText>IF ANULACAODTJ=1 AND INSTANCIA=2  
	STATUSRECURSOS:=0
	IF INDNAORECORRER=1 
		(INDNAORECORRER:=1)=1
	ELSEIF INDNAORECORRER=0 
		(INDNAORECORRER:=0)&lt;&gt;1
	ELSE 
		(INDNAORECORRER:=0)&lt;&gt;1
	ENDIF
ENDIF

IF ORIGEM=SW_NA  
	ORIGEM:="NA"
ENDIF

(FLAGCRZ:=FLAGCONTRARAZAO)&lt;&gt;1</sw:EAIText>
</sw:EAITypeData>
</sw:EAIRunData>
</sw:EAIData>
</sw:ExtAttr>
</xpdl:ExtendedAttribute>
</xpdl:ExtendedAttributes>
