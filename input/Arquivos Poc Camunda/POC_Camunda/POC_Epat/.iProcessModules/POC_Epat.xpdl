<sw:InputParam SubProcField="INDRESPPRM" ParamName="$IP118">
<sw:Script>
<sw:ScriptText>; Input Script For Parameter - INDRESPPRM
IF (STSADMTITCNT=19 OR STSADMTITDRF=19) AND INDRESPPRM=SW_NA  
	INDRESPPRM:=0
ENDIF

IF ANULACAODTJ=1 AND INDRESPPRM=SW_NA  
	INDRESPPRM:=0
ENDIF

IF (IDTIPOIMPUGNACA="6" AND INSTANCIA=2) AND ((STSRESPCNT=4 OR STSRESPSF=4) OR STSPRMSF=4) 
	INDRESPPRM:=1
ELSEIF (IDTIPOIMPUGNACA="6" AND INSTANCIA=2) AND (STSRESPCNT=0 AND STSRESPSF=0) 
	INDRESPPRM:=0
ELSE 
	INDRESPPRM:=INDRESPPRM
ENDIF
; ------- End ------- 
</sw:ScriptText>
