<xpdl:Application Id="51IPMF" Name="EAISCRIPT">
<xpdl:Description>prepSub</xpdl:Description>
<xpdl:FormalParameters/>
<xpdl:ExtendedAttributes>
<xpdl:ExtendedAttribute Name="ExtAttr">
<sw:ExtAttr Name="EAIRunType" xmlns="http://bpm.tibco.com/2004/SWSPDXML2.0">
<sw:EAIRunType>EAISCRIPT</sw:EAIRunType>
</sw:ExtAttr>
</xpdl:ExtendedAttribute>
<xpdl:ExtendedAttribute Name="ExtAttr">
<sw:ExtAttr Name="EAIData" xmlns="http://bpm.tibco.com/2004/SWSPDXML2.0">
<sw:EAIData TypeDataIncomplete="false">
<sw:EAIRunData>
<sw:EAITypeData>
<sw:EAIText>POSICAOINICIO:=0

POSICAOFIM:=0

AUX:=IDSINTIMADOS

INDICESUBDIN:=0
WHILE INDICESUBDIN&lt;=QTDINTIMADOS-1
 
	NRSUBPRO[INDICESUBDIN]:="CONTROLE"
	POSICAOFIM:=SEARCH("|",AUX)
	ARRAYINT[INDICESUBDIN]:=SUBSTR(AUX,1,POSICAOFIM-1)
	POSICAOINICIO:=POSICAOFIM+1
	FIMSTRING:=STRLEN(AUX)
	AUX:=SUBSTR(AUX,POSICAOINICIO,FIMSTRING)
	INDICESUBDIN := INDICESUBDIN+1
WEND

IF CODUADTJ=SW_NA  
	CODUADTJ:=CODUADRT
ENDIF

IF CNTPECA1&lt;&gt;SW_NA  
	IDPECASCNT:=CNTPECA1
ENDIF

IF CNTPECA2&lt;&gt;SW_NA  
	IDPECASCNT:=IDPECASCNT+"|"+CNTPECA2
ENDIF

IF CNTPECA3&lt;&gt;SW_NA  
	IDPECASCNT:=IDPECASCNT+"|"+CNTPECA3
ENDIF

IF CNTPECA4&lt;&gt;SW_NA  
	IDPECASCNT:=IDPECASCNT+"|"+CNTPECA4
ENDIF

IF SFPECA1&lt;&gt;SW_NA  
	IDPECASSF:=SFPECA1
ENDIF

IF SFPECA2&lt;&gt;SW_NA  
	IDPECASSF:=IDPECASSF+"|"+SFPECA2
ENDIF

IF SFPECA3&lt;&gt;SW_NA  
	IDPECASSF:=IDPECASSF+"|"+SFPECA3
ENDIF

IF SFPECA4&lt;&gt;SW_NA  
	IDPECASSF:=IDPECASSF+"|"+SFPECA4
ENDIF

IDSINTIMADOS:="278713|278712|"</sw:EAIText>
</sw:EAITypeData>
</sw:EAIRunData>
</sw:EAIData>
</sw:ExtAttr>
</xpdl:ExtendedAttribute>
</xpdl:ExtendedAttributes>
</xpdl:Application>
</xpdl:Applications>
