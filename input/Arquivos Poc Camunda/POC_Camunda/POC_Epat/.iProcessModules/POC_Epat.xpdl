<xpdl:Application Id="11IPMF" Name="EAISCRIPT">
<xpdl:Description>SETPARAM</xpdl:Description>
<xpdl:FormalParameters/>
<xpdl:ExtendedAttributes>
<xpdl:ExtendedAttribute Name="ExtAttr">
<sw:ExtAttr Name="EAIRunType" xmlns="http://bpm.tibco.com/2004/SWSPDXML2.0">
<sw:EAIRunType>EAISCRIPT</sw:EAIRunType>
</sw:ExtAttr>
</xpdl:ExtendedAttribute>
<xpdl:ExtendedAttribute Name="ExtAttr">
<sw:ExtAttr Name="EAIData" xmlns="http://bpm.tibco.com/2004/SWSPDXML2.0">
<sw:EAIData TypeDataIncomplete="false">
<sw:EAIRunData>
<sw:EAITypeData>
<sw:EAIText>DATETIME:=DATESTR(DATAINICIOPERIO)

IF IDPROCESSO&lt;&gt;SW_NA 
	PROCESS_ID:="idAiim-"+STR(IDAIIM,0)+"idProc-"+STR(IDPROCESSO,0)
ELSE 
	PROCESS_ID:="idAiim-"+STR(IDAIIM,0)+"idProc-NA"
ENDIF

IF MAXRETRIES=SW_NA  
	MAXRETRIES:=5
ENDIF</sw:EAIText>
</sw:EAITypeData>
</sw:EAIRunData>
</sw:EAIData>
</sw:ExtAttr>
</xpdl:ExtendedAttribute>
</xpdl:ExtendedAttributes>
</xpdl:Application>
