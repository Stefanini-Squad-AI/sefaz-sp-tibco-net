$ipmFldName  (QTPECASSEFAZ)
$ipmFldName  (SFDIASREPRESENT)
$ipmFldName  (SFPECA4)
$ipmFldName  (SFPECA2)
$ipmFldName  (SFPECA3)
$ipmFldName  (SFPECA1)
$ipmFldName  (TEMPORESPOSTA)
$ipmFldName  (if (RECAPIT==1 || EXCLUSAOSOLIDAR==true ){1;}&#13;
else {0;})
$ipmFldName  (if ((STSADMTITCNT == 19 || STSADMTITDRF == 19) &amp;&amp; INDRESPPRM == IPESystemValues.SW_NA )&#13;
{&#13;
	INDRESPPRM = 0;&#13;
}&#13;
if (ANULACAODTJ == true &amp;&amp; INDRESPPRM == IPESystemValues.SW_NA )&#13;
{&#13;
	INDRESPPRM = 0;&#13;
}&#13;
if (IDTIPOIMPUGNACA == '6' &amp;&amp; INSTANCIA == 2 &amp;&amp; (STSRESPCNT == 4 || STSRESPSF == 4 || STSPRMSF == 4))&#13;
{&#13;
	INDRESPPRM = 1;&#13;
}&#13;
else if (IDTIPOIMPUGNACA == '6' &amp;&amp; INSTANCIA == 2 &amp;&amp; (STSRESPCNT == 0 &amp;&amp; STSRESPSF == 0))&#13;
{&#13;
	INDRESPPRM = 0;&#13;
}&#13;
else &#13;
{&#13;
	INDRESPPRM = INDRESPPRM;&#13;
})
$ipmFldName  (STSADMTITCNT)
$ipmFldName  (STSADMTITDRF)
$ipmFldName  (ANULACAODTJ)
$ipmFldName  ('ePAT')
$ipmFldName  ('iProcess')
$ipmFldName  (IPEConversionUtil.STR(SW_CASENUM,0))
$ipmFldName  (IPEProcessNameUtil.GETPROCESSNAME('POC_EpatProcess');)
$ipmFldName  (DESCREGRA)
$ipmFldName  (No_Mapping)
$ipmFldName  (No_Mapping)
$ipmFldName  (FLGALC)
$ipmFldName  (INDNAORECORRER)
$ipmFldName  (STSPETICAO)
FLAGCRZ  (FLAGCRZ)

</sw:AnnotText>
</sw:Annotation>
