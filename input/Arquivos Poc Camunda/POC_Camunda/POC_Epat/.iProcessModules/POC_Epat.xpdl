<sw:EAIData TypeDataIncomplete="false">
<sw:EAIRunData>
<sw:EAITypeData>
<sw:EAIText>&lt;?xml version="1.0" encoding="UTF-8" standalone="yes"?&gt;
&lt;EAI_Java_Plugin xmlns="http://www.staffware.com/2003/EAIJavaPlugin"&gt;
    &lt;General&gt;
        &lt;Object_Name&gt;com.staffware.eaiframework.runtime.library.engine.SWFramework&lt;/Object_Name&gt;
        &lt;Cache_Object&gt;true&lt;/Cache_Object&gt;
        &lt;Call_Type&gt;Immediate&lt;/Call_Type&gt;
		&lt;Configuration_Key&gt;BW01&lt;/Configuration_Key&gt;
    &lt;/General&gt;
    &lt;Mappings&gt;
        &lt;Mapped_Inputs&gt;
            &lt;Staffware_Input_Field Array="false"&gt;DATETIME&lt;/Staffware_Input_Field&gt;
        &lt;/Mapped_Inputs&gt;
        &lt;Mapped_Inputs&gt;
            &lt;Staffware_Input_Field Array="false"&gt;NRAIIM&lt;/Staffware_Input_Field&gt;
        &lt;/Mapped_Inputs&gt;
        &lt;Mapped_Inputs&gt;
            &lt;Staffware_Input_Field Array="false"&gt;PROCESS_ID&lt;/Staffware_Input_Field&gt;
        &lt;/Mapped_Inputs&gt;
        &lt;Mapped_Inputs&gt;
            &lt;Staffware_Input_Field Array="false"&gt;SW_MAINCASE&lt;/Staffware_Input_Field&gt;
        &lt;/Mapped_Inputs&gt;
        &lt;Mapped_Outputs&gt;
            &lt;Staffware_Field Array="false"&gt;DUMP&lt;/Staffware_Field&gt;
        &lt;/Mapped_Outputs&gt;
