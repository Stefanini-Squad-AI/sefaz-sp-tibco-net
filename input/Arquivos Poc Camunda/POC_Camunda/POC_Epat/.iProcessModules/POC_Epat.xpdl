<sw:EAIRunData>
<sw:EAITypeData>
<sw:EAIText>IF NUMAPPRETRIES=SW_NA 
	NUMAPPRETRIES:=0
ELSE 
	NUMAPPRETRIES:=NUMAPPRETRIES+1
ENDIF

ISAPPERROR:="N"

ISTECHERROR:="N"

OUTCOME:="OK"

DATETIME:=DATESTR(SW_DATE)</sw:EAIText>
</sw:EAITypeData>
</sw:EAIRunData>
