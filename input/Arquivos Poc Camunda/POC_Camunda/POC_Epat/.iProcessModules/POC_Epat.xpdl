<xpdl:Application Id="2IPMF" Name="EAISCRIPT">
<xpdl:Description>SETSUBPR</xpdl:Description>
<xpdl:FormalParameters/>
<xpdl:ExtendedAttributes>
<xpdl:ExtendedAttribute Name="ExtAttr">
<sw:ExtAttr Name="EAIRunType" xmlns="http://bpm.tibco.com/2004/SWSPDXML2.0">
<sw:EAIRunType>EAISCRIPT</sw:EAIRunType>
</sw:ExtAttr>
</xpdl:ExtendedAttribute>
<xpdl:ExtendedAttribute Name="ExtAttr">
<sw:ExtAttr Name="EAIData" xmlns="http://bpm.tibco.com/2004/SWSPDXML2.0">
<sw:EAIData TypeDataIncomplete="false">
<sw:EAIRunData>
<sw:EAITypeData>
<sw:EAIText>IF IDMOTIVOINTIMAC=1  
	IF (IDDECISAODEBITO=3 OR IDDECISAODEBITO=0) AND DEFESAADMITIDA=1 
		AGUARDAR[0]:="AgPRJ"
	ELSEIF IDDECISAODEBITO=0 AND DEFESAADMITIDA=0  
		AGUARDAR[0]:="AgRecPRJ"
	ENDIF
	IF IDDECISAODEBITO=1 OR IDDECISAODEBITO=2  
		IF RECURSOOFICIO=1 
			AGUARDAR[0]:="AgPRJ"
		ELSEIF RECURSOOFICIO=0  
			AGUARDAR[0]:="AgRecPRJ"
		ENDIF
	ENDIF
	IF IDTIPOIMPUGNACA="4"  
		AGUARDAR[0]:="AgPRJR"
	ENDIF
ENDIF

IF IDMOTIVOINTIMAC=2  
	AGUARDAR[0]:="AgPecas"
ENDIF

IF CRCONTRIBUINTE=1  
	IF IDDECISAODEBITO=1 OR (IDDECISAODEBITO=2 AND RECURSOOFICIO=1) 
		AGUARDAR[0]:="AgRCRaz"
	ELSE 
		AGUARDAR[0]:="AgCRaz"
	ENDIF
ENDIF

IF DILIGENCIA=1  
	AGUARDAR[0]:="AgPetica"
ENDIF

PROCRETORNO:=AGUARDAR[0]

IF DSTIPOINTIMACAO="DE" OR DTCIENCIA=SW_NA  
	DTCIENCIA:=DTPUBLICACAODE
ENDIF

IF NOVOMODELO=1  
	AGUARDAR[0]:="AgPecas"
	PROCRETORNO:=AGUARDAR[0]
ENDIF</sw:EAIText>
</sw:EAITypeData>
</sw:EAIRunData>
</sw:EAIData>
</sw:ExtAttr>
</xpdl:ExtendedAttribute>
</xpdl:ExtendedAttributes>
</xpdl:Application>
<xpdl:Application Id="4IPMF" Name="EAISCRIPT">
<xpdl:Description>CTLPRAZO</xpdl:Description>
<xpdl:FormalParameters/>
<xpdl:ExtendedAttributes>
<xpdl:ExtendedAttribute Name="ExtAttr">
<sw:ExtAttr Name="EAIRunType" xmlns="http://bpm.tibco.com/2004/SWSPDXML2.0">
<sw:EAIRunType>EAISCRIPT</sw:EAIRunType>
</sw:ExtAttr>
</xpdl:ExtendedAttribute>
<xpdl:ExtendedAttribute Name="ExtAttr">
<sw:ExtAttr Name="EAIData" xmlns="http://bpm.tibco.com/2004/SWSPDXML2.0">
<sw:EAIData TypeDataIncomplete="false">
<sw:EAIRunData>
<sw:EAITypeData>
<sw:EAIText>IF DSTIPOINTIMACAO="Carta com AR" 
	PERIODOEMDIAS:=360
ELSEIF DSTIPOINTIMACAO="DE" 
	PRAZOCIENCIA:=DTPUBLICACAODE
	PERIODOEMDIAS:=0
ELSE 
	PERIODOEMDIAS:=10
ENDIF

NOVOMODELO=1</sw:EAIText>
</sw:EAITypeData>
</sw:EAIRunData>
</sw:EAIData>
</sw:ExtAttr>
</xpdl:ExtendedAttribute>
</xpdl:ExtendedAttributes>
</xpdl:Application>
