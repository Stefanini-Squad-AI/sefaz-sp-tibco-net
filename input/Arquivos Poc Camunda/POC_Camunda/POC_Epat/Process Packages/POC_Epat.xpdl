    <xpdl2:DataField Id="_zJIHQFqiEfG5K7mY0I3I6w" xpdExt:DisplayName="IsAppError" Name="ISAPPERROR">
      <xpdl2:DataType>
        <xpdl2:BasicType Type="STRING">
          <xpdl2:Length>1</xpdl2:Length>
        </xpdl2:BasicType>
      </xpdl2:DataType>
      <xpdl2:Description>Indicador de que houve um erro de aplicacao (ex, ausencia da informacao no sistema/banco envolvido no servico)</xpdl2:Description>
    </xpdl2:DataField>
    <xpdl2:DataField Id="_zJIHQVqiEfG5K7mY0I3I6w" xpdExt:DisplayName="SW_MAINPROC" Name="SW_MAINPROC">
      <xpdl2:DataType>
        <xpdl2:BasicType Type="STRING">
          <xpdl2:Length>8</xpdl2:Length>
        </xpdl2:BasicType>
      </xpdl2:DataType>
      <xpdl2:Description>Nome do processo da procedure que iniciou o caso, no caso do epat, o numero se refere ao numero do caso do processo DEAT0010.</xpdl2:Description>
    </xpdl2:DataField>
    <xpdl2:DataField Id="_zJIHQ1qiEfG5K7mY0I3I6w" xpdExt:DisplayName="MaxRetries" Name="MAXRETRIES">
      <xpdl2:DataType>
        <xpdl2:BasicType Type="INTEGER">
          <xpdl2:Precision>10</xpdl2:Precision>
        </xpdl2:BasicType>
      </xpdl2:DataType>
      <xpdl2:Description>numero maximo de tentativas antes que o processo caia em fila de tratamento de excessao</xpdl2:Description>
    </xpdl2:DataField>
    <xpdl2:DataField Id="_zJIHRFqiEfG5K7mY0I3I6w" xpdExt:DisplayName="IsTechError" Name="ISTECHERROR">
      <xpdl2:DataType>
        <xpdl2:BasicType Type="STRING">
          <xpdl2:Length>1</xpdl2:Length>
        </xpdl2:BasicType>
      </xpdl2:DataType>
      <xpdl2:Description>Indicador de que houve um erro de sistema (ex, servico indisponivel)</xpdl2:Description>
    </xpdl2:DataField>
    <xpdl2:DataField Id="_zJIHR1qiEfG5K7mY0I3I6w" xpdExt:DisplayName="STATUS_CODE" Name="STATUS_CODE" ReadOnly="false">
      <xpdl2:DataType>
        <xpdl2:BasicType Type="STRING">
          <xpdl2:Length>50</xpdl2:Length>
        </xpdl2:BasicType>
      </xpdl2:DataType>
      <xpdl2:Description>Status da chamada, considera-se chamada bem sucedida quando o servico retorna o valor 0 para o campo.</xpdl2:Description>
    </xpdl2:DataField>
    <xpdl2:DataField Id="_zJIHSFqiEfG5K7mY0I3I6w" xpdExt:DisplayName="DATETIME" Name="DATETIME" ReadOnly="false">
      <xpdl2:DataType>
        <xpdl2:BasicType Type="STRING">
          <xpdl2:Length>50</xpdl2:Length>
        </xpdl2:BasicType>
      </xpdl2:DataType>
      <xpdl2:Description>Data e Hora da entrada no subprocesso o campo sera enviado ao servico.</xpdl2:Description>
    </xpdl2:DataField>
    <xpdl2:DataField Id="_zJIHSVqiEfG5K7mY0I3I6w" xpdExt:DisplayName="Outcome" Name="OUTCOME">
      <xpdl2:DataType>
        <xpdl2:BasicType Type="STRING">
          <xpdl2:Length>10</xpdl2:Length>
        </xpdl2:BasicType>
      </xpdl2:DataType>
      <xpdl2:Description>Resultado da consulta, valor validado para que o fluxo considere a chamada bem sucedida, OK</xpdl2:Description>
    </xpdl2:DataField>
    <xpdl2:DataField Id="_zJIHSlqiEfG5K7mY0I3I6w" xpdExt:DisplayName="DUMP" Name="DUMP">
      <xpdl2:DataType>
        <xpdl2:BasicType Type="STRING"/>
      </xpdl2:DataType>
      <xpdl2:Description>Dump do request executado no servico.</xpdl2:Description>
    </xpdl2:DataField>
    <xpdl2:DataField Id="_zJIHT1qiEfG5K7mY0I3I6w" xpdExt:DisplayName="STErrorDesc" Name="STERRORDESC">
      <xpdl2:DataType>
        <xpdl2:BasicType Type="STRING">
          <xpdl2:Length>100</xpdl2:Length>
        </xpdl2:BasicType>
      </xpdl2:DataType>
      <xpdl2:Description>Descricao do erro da chamada do servico.</xpdl2:Description>
    </xpdl2:DataField>
    <xpdl2:DataField Id="_zJIHUFqiEfG5K7mY0I3I6w" xpdExt:DisplayName="NumAppRetries" Name="NUMAPPRETRIES">
      <xpdl2:DataType>
        <xpdl2:BasicType Type="INTEGER">
          <xpdl2:Precision>10</xpdl2:Precision>
        </xpdl2:BasicType>
      </xpdl2:DataType>
      <xpdl2:Description>numero da tentativa corrente</xpdl2:Description>
    </xpdl2:DataField>
    <xpdl2:DataField Id="_zJIHUVqiEfG5K7mY0I3I6w" xpdExt:DisplayName="PROCESS_ID" Name="PROCESS_ID">
      <xpdl2:DataType>
        <xpdl2:BasicType Type="STRING">
          <xpdl2:Length>35</xpdl2:Length>
        </xpdl2:BasicType>
      </xpdl2:DataType>
      <xpdl2:Description>identificador da chamada (para efeitos de log) nos casos do ePat, o valor padrao é:&#xD;
idAiim e idProcesso</xpdl2:Description>
    </xpdl2:DataField>
    <xpdl2:DataField Id="_zJIHUlqiEfG5K7mY0I3I6w" xpdExt:DisplayName="STErrorCode" Name="STERRORCODE">
      <xpdl2:DataType>
        <xpdl2:BasicType Type="STRING">
          <xpdl2:Length>50</xpdl2:Length>
        </xpdl2:BasicType>
      </xpdl2:DataType>
      <xpdl2:Description>Codigo do erro da chamada do servico.</xpdl2:Description>
    </xpdl2:DataField>
    <xpdl2:DataField Id="_zJIHU1qiEfG5K7mY0I3I6w" xpdExt:DisplayName="SERVICE_NAME" Name="SERVICE_NAME">
      <xpdl2:DataType>
        <xpdl2:BasicType Type="STRING">
          <xpdl2:Length>50</xpdl2:Length>
        </xpdl2:BasicType>
      </xpdl2:DataType>
      <xpdl2:Description>Nome do servico retornado na chamada</xpdl2:Description>
    </xpdl2:DataField>
    <xpdl2:DataField Id="_nBlBIV6IEfGBBLgT-R5iuw" xpdExt:DisplayName="participante" Name="PARTICIPANTE">
      <xpdl2:DataType>
        <xpdl2:BasicType Type="PERFORMER"/>
      </xpdl2:DataType>
      <xpdl2:Description>Identifica o responsável por fazer determinada atividade.</xpdl2:Description>
    </xpdl2:DataField>
  </xpdl2:DataFields>
