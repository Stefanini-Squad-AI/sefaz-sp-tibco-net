        <xpdl2:Activity Id="_zJIHVlqiEfG5K7mY0I3I6w" Name="SETPARAM" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="SetParameters" iProcessExt:StepIndex="5">
          <xpdl2:Description>Script para inicializacao de parametros utilizados no fluxo ou na chamada de servico na primeira vez em que o fluxo é inciado.</xpdl2:Description>
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">&#xD;
DATETIME = IPEConversionUtil.DATESTR(DATAINICIOPERIO);&#xD;
if(IDPROCESSO != IPESystemValues.SW_NA){&#xD;
	PROCESS_ID = 'idAiim-'+IPEConversionUtil.STR(IDAIIM,0)+'idProc-' + IPEConversionUtil.STR(IDPROCESSO,0);&#xD;
} else {&#xD;
	PROCESS_ID = 'idAiim-'+IPEConversionUtil.STR(IDAIIM,0)+'idProc-NA';&#xD;
}&#xD;
if (MAXRETRIES==null) {&#xD;
   MAXRETRIES=5;&#xD;
}&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
