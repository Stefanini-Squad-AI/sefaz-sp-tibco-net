          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">if (DSTIPOINTIMACAO==&quot;Carta com AR&quot;){&#xD;
   PERIODOEMDIAS=360;}&#xD;
else if (DSTIPOINTIMACAO==&quot;DE&quot;){&#xD;
	PRAZOCIENCIA = DTPUBLICACAODE;&#xD;
	PERIODOEMDIAS=0;&#xD;
	}&#xD;
else {&#xD;
	PERIODOEMDIAS=10;&#xD;
	}&#xD;
&#xD;
&#xD;
NOVOMODELO == true;</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
