}&#xD;
else {&#xD;
   NUMAPPRETRIES=NUMAPPRETRIES+1;&#xD;
}&#xD;
ISAPPERROR='N';&#xD;
ISTECHERROR='N';&#xD;
OUTCOME='OK';&#xD;
DATETIME = IPEConversionUtil.DATESTR(IPESystemValues.SW_DATE);&#xD;
</xpdl2:Script>
