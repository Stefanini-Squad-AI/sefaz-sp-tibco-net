          <xpdl2:Description>Inicializador de contadores do servico e definicao de parametros iniciais de erro </xpdl2:Description>
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">if (NUMAPPRETRIES==null) {&#xD;
