        <xpdl2:Activity Id="_zE3XeV6JEfGBBLgT-R5iuw" Name="prepSub" xpdExt:Visibility="Private" xpdExt:DisplayName="prepSub" iProcessExt:StepIndex="86">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">POSICAOINICIO = 0;&#xD;
POSICAOFIM = 0;&#xD;
AUX = IDSINTIMADOS;&#xD;
for(INDICESUBDIN = 0; INDICESUBDIN &lt;= QTDINTIMADOS-1; INDICESUBDIN ++) {&#xD;
	NRSUBPRO[INDICESUBDIN] = &quot;CONTROLE&quot;;&#xD;
	POSICAOFIM = IPEStringUtil.SEARCH(&quot;|&quot;,AUX);&#xD;
	ARRAYINT[INDICESUBDIN]=IPEStringUtil.SUBSTR(AUX,1,POSICAOFIM-1);&#xD;
	POSICAOINICIO = POSICAOFIM+1;&#xD;
    FIMSTRING = IPEStringUtil.STRLEN(AUX);&#xD;
	AUX = IPEStringUtil.SUBSTR(AUX,POSICAOINICIO,FIMSTRING);&#xD;
}&#xD;
if (CODUADTJ == IPESystemValues.SW_NA){&#xD;
	CODUADTJ = CODUADRT;&#xD;
	}&#xD;
/*if (CNTPECA1=='110' || CNTPECA1=='24' || CNTPECA1=='53' || CNTPECA1=='55' || CNTPECA1=='22'){&#xD;
   IDPECASCNT = CNTPECA1;}*/&#xD;
&#xD;
if(CNTPECA1 != IPESystemValues.SW_NA){&#xD;
   	IDPECASCNT = CNTPECA1;}&#xD;
   	&#xD;
if(CNTPECA2 != IPESystemValues.SW_NA){&#xD;
   	IDPECASCNT = IDPECASCNT + '|' + CNTPECA2;}&#xD;
   	&#xD;
if (CNTPECA3 != IPESystemValues.SW_NA){&#xD;
   IDPECASCNT = IDPECASCNT + '|' + CNTPECA3;}&#xD;
&#xD;
if (CNTPECA4 !=IPESystemValues.SW_NA){&#xD;
   IDPECASCNT = IDPECASCNT + '|' + CNTPECA4;}&#xD;
&#xD;
&#xD;
/*if (SFPECA1=='50' || SFPECA1=='24' || SFPECA1=='53' || SFPECA1=='49' || SFPECA1=='55' || SFPECA1=='110'){&#xD;
   IDPECASSF = SFPECA1;}*/&#xD;
&#xD;
if (SFPECA1 != IPESystemValues.SW_NA){&#xD;
   IDPECASSF = SFPECA1;}&#xD;
&#xD;
if (SFPECA2 != IPESystemValues.SW_NA){&#xD;
   IDPECASSF = IDPECASSF + '|' + SFPECA2;}&#xD;
&#xD;
if (SFPECA3 != IPESystemValues.SW_NA){&#xD;
   IDPECASSF = IDPECASSF + '|' + SFPECA3;}&#xD;
&#xD;
if (SFPECA4 != IPESystemValues.SW_NA){&#xD;
   IDPECASSF = IDPECASSF + '|' + SFPECA4;}&#xD;
   &#xD;
   IDSINTIMADOS = '278713|278712|';&#xD;
   /*--278711|278710|278709|278708|278707|278706|278705|278704|278703|278702|278701|278700|278699|278698|278697|278696|278695|278694|278693|278692|278691|';*/&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
