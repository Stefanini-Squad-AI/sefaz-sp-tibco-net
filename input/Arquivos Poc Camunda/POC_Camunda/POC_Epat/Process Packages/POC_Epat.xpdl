          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">FIELDSNAMES=&quot;procRetorno|caseRetorno|&quot;;&#xD;
FIELDSTYPES=&quot;swText|swNumeric|&quot;;&#xD;
FIELDSVALUES=IPESystemValues.SW_PRONAME + &quot;|&quot; + IPEConversionUtil.STR(IPESystemValues.SW_CASENUM,0) +&quot;|&quot;;&#xD;
&#xD;
if (CNTPECA1!=IPESystemValues.SW_NA || CNTPECA1!='9') {&#xD;
	IDPECAS = IDPECAS + CNTPECA1+ '|' ;&#xD;
	}&#xD;
if (CNTPECA2!=IPESystemValues.SW_NA) {&#xD;
	IDPECAS = IDPECAS + CNTPECA2+ '|' ;&#xD;
	}&#xD;
if (CNTPECA3!=IPESystemValues.SW_NA) {&#xD;
	IDPECAS = IDPECAS + CNTPECA3+ '|' ;&#xD;
	}&#xD;
if (CNTPECA4!=IPESystemValues.SW_NA) {&#xD;
	IDPECAS = IDPECAS + CNTPECA4+ '|' ;&#xD;
	}&#xD;
PERIODOEMDIAS= IPEConversionUtil.NUM(TEMPORESPOSTA);&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
