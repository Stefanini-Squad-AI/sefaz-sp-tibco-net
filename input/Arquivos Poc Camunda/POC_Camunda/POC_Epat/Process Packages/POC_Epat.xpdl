        <xpdl2:Activity Id="_-bkw-F6JEfGBBLgT-R5iuw" Name="SETSUBPR" xpdExt:Visibility="Private" iProcessExt:StepIndex="8" xpdExt:DisplayName="ISetSubProc">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//idmotivos7&#xD;
//1 - Decisao&#xD;
//2 - Vicio&#xD;
//3 - Diligencia&#xD;
//&#xD;
//iddeciaodebito&#xD;
// 1 mantido&#xD;
// 2 reduzido&#xD;
// 3 cancelado&#xD;
//&#xD;
&#xD;
if(IDMOTIVOINTIMAC == 1){&#xD;
	if ((IDDECISAODEBITO == 3 || IDDECISAODEBITO == 0) &amp;&amp; DEFESAADMITIDA == true)&#xD;
		{AGUARDAR[0] = &quot;AgPRJ&quot;;}&#xD;
	else if (IDDECISAODEBITO == 0 &amp;&amp; DEFESAADMITIDA == false)&#xD;
		{AGUARDAR[0] = &quot;AgRecPRJ&quot;;}	&#xD;
	&#xD;
	if (IDDECISAODEBITO == 1 || IDDECISAODEBITO == 2){&#xD;
		if (RECURSOOFICIO == true)&#xD;
		{AGUARDAR[0] = &quot;AgPRJ&quot;;}&#xD;
		else if (RECURSOOFICIO == false)&#xD;
		{AGUARDAR[0] = &quot;AgRecPRJ&quot;;}&#xD;
	}&#xD;
	if (IDTIPOIMPUGNACA == '4' )&#xD;
		{AGUARDAR[0] = &quot;AgPRJR&quot;;}&#xD;
}&#xD;
//falta implementar regras para PRJ&#xD;
if (IDMOTIVOINTIMAC == 2){&#xD;
	AGUARDAR[0] = &quot;AgPecas&quot;;&#xD;
} &#xD;
if (CRCONTRIBUINTE == 1 ){&#xD;
	if (IDDECISAODEBITO == 1 || IDDECISAODEBITO == 2 &amp;&amp; RECURSOOFICIO==true){&#xD;
		AGUARDAR[0] = &quot;AgRCRaz&quot;;}&#xD;
	else {&#xD;
		AGUARDAR[0] = &quot;AgCRaz&quot;;}&#xD;
	}&#xD;
&#xD;
&#xD;
if (DILIGENCIA == true){&#xD;
	AGUARDAR[0] = &quot;AgPetica&quot;;&#xD;
}&#xD;
PROCRETORNO = AGUARDAR[0];&#xD;
&#xD;
//alterado para verificar se a intimacao teve ciencia, se nao houver considerar a data da publicacao.&#xD;
if (DSTIPOINTIMACAO=='DE' || DTCIENCIA==IPESystemValues.SW_NA )&#xD;
	{DTCIENCIA=DTPUBLICACAODE;}&#xD;
&#xD;
&#xD;
//if (Instancia==2 || vicioRepresentacao == true || (Instancia == 1 &amp;&amp; defesaAdmitida == false &amp;&amp; diligencia!=true) ){&#xD;
if (NOVOMODELO == true) {&#xD;
	AGUARDAR[0] = &quot;AgPecas&quot;;&#xD;
	PROCRETORNO = AGUARDAR[0];&#xD;
	}&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="64.0" LaneId="_-bkx7V6JEfGBBLgT-R5iuw" Width="96.0">
              <xpdl2:Coordinates XCoordinate="544.0" YCoordinate="152.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
          <iProcessExt:TaskProperties NoDeleteOnWithdraw="false" IgnoreCaseSuspend="false">
            <iProcessExt:Prediction UseDeadlineForDuration="false" DontIncludeAsFutureWorkItem="false"/>
          </iProcessExt:TaskProperties>
          <xpdExt:AssociatedParameters DisableImplicitAssociation="false">
            <xpdExt:AssociatedParameter FormalParam="DSTIPOINTIMACAO" Mode="INOUT" Mandatory="false">
              <xpdl2:Description>Valores possiveis&#xD;
- DE&#xD;
- Carta com AR&#xD;
- Portal do Contribuinte</xpdl2:Description>
            </xpdExt:AssociatedParameter>
            <xpdExt:AssociatedParameter FormalParam="AGUARDAR" Mode="INOUT" Mandatory="false">
              <xpdl2:Description></xpdl2:Description>
            </xpdExt:AssociatedParameter>
            <xpdExt:AssociatedParameter FormalParam="PROCRETORNO" Mode="INOUT" Mandatory="false">
              <xpdl2:Description></xpdl2:Description>
            </xpdExt:AssociatedParameter>
            <xpdExt:AssociatedParameter FormalParam="IDDECISAODEBITO" Mode="INOUT" Mandatory="false">
              <xpdl2:Description>Identifica o tipo de decisão de débito.</xpdl2:Description>
            </xpdExt:AssociatedParameter>
            <xpdExt:AssociatedParameter FormalParam="DEFESAADMITIDA" Mode="INOUT" Mandatory="false">
              <xpdl2:Description>Identifica se a defesa interposta foi admitida.</xpdl2:Description>
            </xpdExt:AssociatedParameter>
            <xpdExt:AssociatedParameter FormalParam="RECURSOOFICIO" Mode="INOUT" Mandatory="false">
              <xpdl2:Description>Identifica se há recurso de ofício interposto.</xpdl2:Description>
            </xpdExt:AssociatedParameter>
            <xpdExt:AssociatedParameter FormalParam="IDMOTIVOINTIMAC" Mode="INOUT" Mandatory="true">
              <xpdl2:Description>Identifica o motivo da intimação.</xpdl2:Description>
            </xpdExt:AssociatedParameter>
            <xpdExt:AssociatedParameter FormalParam="DILIGENCIA" Mode="INOUT" Mandatory="false">
              <xpdl2:Description>Identifica se foi solicitada Diligência.</xpdl2:Description>
            </xpdExt:AssociatedParameter>
            <xpdExt:AssociatedParameter FormalParam="IDTIPOIMPUGNACA" Mode="INOUT" Mandatory="false">
              <xpdl2:Description>Identificador do tipo de impugnação.</xpdl2:Description>
            </xpdExt:AssociatedParameter>
            <xpdExt:AssociatedParameter FormalParam="CRCONTRIBUINTE" Mode="INOUT" Mandatory="false">
              <xpdl2:Description>Identifica se há contra razão do Contribuinte.</xpdl2:Description>
            </xpdExt:AssociatedParameter>
            <xpdExt:AssociatedParameter FormalParam="NOVOMODELO" Mode="INOUT" Mandatory="true">
              <xpdl2:Description>Identifica se o Auto de Infração e Imposição de Multa utiliza o novo modelo de intimações.</xpdl2:Description>
            </xpdExt:AssociatedParameter>
            <xpdExt:AssociatedParameter FormalParam="DTCIENCIA" Mode="INOUT" Mandatory="true">
              <xpdl2:Description>Data que o contribuinte tomou ciência da intimação.</xpdl2:Description>
            </xpdExt:AssociatedParameter>
            <xpdExt:AssociatedParameter FormalParam="DTPUBLICACAODE" Mode="INOUT" Mandatory="true">
              <xpdl2:Description>Data da publicação no Diário Eletronico (DE).</xpdl2:Description>
            </xpdExt:AssociatedParameter>
          </xpdExt:AssociatedParameters>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_-bkw-V6JEfGBBLgT-R5iuw" Name="AGUARDAR" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" iProcessExt:StepIndex="9" xpdExt:DisplayName="Aguardar Retorno">
          <xpdl2:Implementation>
