  <form:pane name="pane.messages" paneType="com.tibco.forms.panes.messages">
    <form:label>Invalid Entries</form:label>
    <form:visible>true</form:visible>
    <form:enabled>true</form:enabled>
    <form:labelProperties visible="false"/>
  </form:pane>
</form:form>