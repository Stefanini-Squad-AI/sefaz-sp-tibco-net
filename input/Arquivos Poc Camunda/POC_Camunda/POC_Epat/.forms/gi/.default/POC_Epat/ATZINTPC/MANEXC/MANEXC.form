      <form:enabled>false</form:enabled>
      <form:required>false</form:required>
    </form:control>
    <form:control controlType="com.tibco.forms.controls.textinput" name="control.STERRORCODE">
      <form:propertySet xsi:type="et:TextPropertySet">
        <et:displayLength>40</et:displayLength>
        <et:maxLength>50</et:maxLength>
      </form:propertySet>
      <form:label>STErrorCode</form:label>
      <form:hint></form:hint>
      <form:visible>true</form:visible>
      <form:enabled>false</form:enabled>
      <form:validation generated="true" name="STERRORCODE__length" type="javascript" when="oncontrolchange" simple="true">
        <form:script>context.value.length &lt;= 50;</form:script>
        <form:message>'STErrorCode' not valid: expecting a value with no more than 50 characters</form:message>
      </form:validation>
      <form:required>false</form:required>
    </form:control>
    <form:control controlType="com.tibco.forms.controls.textinput" name="control.DATETIME">
