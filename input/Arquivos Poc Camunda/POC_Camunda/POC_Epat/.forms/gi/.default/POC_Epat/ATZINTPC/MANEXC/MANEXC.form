    <form:control controlType="com.tibco.forms.controls.textinput" name="control.MAXRETRIES">
      <form:propertySet xsi:type="et:TextPropertySet">
        <et:displayLength>15</et:displayLength>
        <et:maxLength>11</et:maxLength>
        <et:numeric>true</et:numeric>
      </form:propertySet>
      <form:label>MaxRetries</form:label>
      <form:hint></form:hint>
      <form:visible>true</form:visible>
      <form:enabled>false</form:enabled>
      <form:validation generated="true" name="MAXRETRIES__length" type="javascript" when="oncontrolchange" simple="true">
        <form:script>!isNaN(context.value) &amp;&amp; this.getForm().numberFormat(context.value.valueOf(), 10, 0);</form:script>
        <form:message>'MaxRetries' not valid: expecting an integer with no more than 10 digits</form:message>
      </form:validation>
      <form:validation generated="true" name="MAXRETRIES__lowerLimit" type="javascript" when="oncontrolchange" simple="true">
        <form:script>isNaN(context.value) || context.value.valueOf() >= -2147483648;</form:script>
        <form:message>'MaxRetries' not valid: expecting a value greater than or equal to -2147483648</form:message>
      </form:validation>
      <form:validation generated="true" name="MAXRETRIES__upperLimit" type="javascript" when="oncontrolchange" simple="true">
        <form:script>isNaN(context.value) || context.value.valueOf() &lt;= 2147483647;</form:script>
        <form:message>'MaxRetries' not valid: expecting a value less than or equal to 2147483647</form:message>
